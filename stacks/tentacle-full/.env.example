# ══════════════════════════════════════════════════════════════════════════
#  Tentacle TV — optional settings for the FULL stack
# ══════════════════════════════════════════════════════════════════════════
#  Nothing here is required: every line has a working default. To change a
#  value, copy this file to .env (next to compose.yaml), uncomment the line
#  and edit it, then run `docker compose up -d` again.
#  There is NO password to set: the database secrets are generated on the
#  first start and stay in the tentacle-secrets volume.

# ── Media ─────────────────────────────────────────────────────────────────
# Folder on THIS machine holding your movies and shows. Jellyfin sees it as
# /media; the setup wizard creates the "Films" and "Séries" libraries on
# /media/films and /media/series (created on first start if missing).
# MEDIA_PATH=./media
# MEDIA_PATH=/srv/media

# ── Ports on this machine ─────────────────────────────────────────────────
# TENTACLE_PORT=3000
# JELLYFIN_PORT=8096

# ── Time zone (scheduled tasks, logs) ─────────────────────────────────────
# TZ=Europe/Paris

# ── User owning the files ─────────────────────────────────────────────────
# Jellyfin and Tentacle run as this user, never as root. Use the ids of
# the account that owns your media folder (`id -u` and `id -g`).
# PUID=1000
# PGID=1000

# ── Image version ─────────────────────────────────────────────────────────
# "latest" follows every release; pin a version (e.g. v1.23.0) to update
# only when you decide to.
# TENTACLE_VERSION=latest

# ── Public access over HTTPS (profiles "caddy" or "traefik") ──────────────
# Domains pointing to your public IP, with ports 80 and 443 forwarded to
# this machine. Then: docker compose --profile caddy up -d
# TENTACLE_DOMAIN=tentacle.example.com
# JELLYFIN_DOMAIN=jellyfin.example.com
# Host ports of the reverse proxy (keep 80/443 for Let's Encrypt).
# HTTP_PORT=80
# HTTPS_PORT=443
