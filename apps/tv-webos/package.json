{
  "name": "@tentacle-tv/tv-webos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Client LG webOS — coquille IPK + variante de build servie par le serveur Tentacle",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "vite build --config config/vite.config.ts",
    "tokens": "vite-node scripts/tvTokens.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ipk": "node scripts/ipk.mjs",
    "icons": "node scripts/icons.mjs",
    "emu:install": "node scripts/emulator.mjs install",
    "emu:launch": "node scripts/emulator.mjs launch",
    "capture": "node scripts/playbackCapture.mjs",
    "capture:page": "node scripts/layoutCapture.mjs"
  },
  "dependencies": {
    "@tentacle-tv/api-client": "workspace:*",
    "@tentacle-tv/shared": "workspace:*",
    "@tentacle-tv/theme": "workspace:*",
    "@tentacle-tv/tv-core": "workspace:*",
    "@tentacle-tv/ui": "workspace:*",
    "@tentacle-tv/web": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-legacy": "^6.1.1",
    "@vitejs/plugin-react": "^4.3.0",
    "@webos-tools/cli": "^3.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "terser": "^5.36.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
