<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifeste MSIX pour le Microsoft Store (app Win32 full-trust packagée).
  Identité réservée par le Partner Center (NE PAS modifier Name/Publisher) :
    Name      = DamienROUGE.Tentacle
    Publisher = CN=85A5E4E3-C832-4F7E-9A49-71BD355586E2
    PFN       = DamienROUGE.Tentacle_nc896ct3kqbem
  La VERSION est réécrite par le workflow depuis le tag (X.Y.Z.0 — le 4e champ
  doit rester 0 pour le Store). L'exécutable doit s'appeler comme la sortie Tauri.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="DamienROUGE.Tentacle"
    Publisher="CN=85A5E4E3-C832-4F7E-9A49-71BD355586E2"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Tentacle TV</DisplayName>
    <PublisherDisplayName>Damien ROUGE</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22631.0" />
  </Dependencies>

  <Resources>
    <Resource Language="fr-FR" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="TentacleTV" Executable="Tentacle TV.exe" EntryPoint="Windows.FullTrustApplication">
      <!-- Visuels QUALIFIÉS (brand/windows.py, `generate-icons.py`) : chaque nom
           ci-dessous désigne ses variantes .scale-100 à 400, et l'icône de la liste
           ses .targetsize-16 à 256 en trois habits (plaque, altform-unplated,
           altform-lightunplated), résolus par resources.pri
           (.github/scripts/msix-resources.mjs). La mascotte seule sur
           transparent : aucune plaque peinte, et BackgroundColor transparent
           laisse aux tuiles de Windows 10 la couleur du thème. -->
      <uap:VisualElements
        DisplayName="Tentacle TV"
        Description="Client multimedia pour serveur multimedia auto-heberge"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <!-- Les liens d'Octave (`tentacle://octave/…`) : Windows lance l'app avec le lien en argument
           (src/main/appLinks.ts). Le schéma du mobile, le même : jamais renommé. -->
      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="tentacle">
            <uap:DisplayName>Tentacle TV</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
