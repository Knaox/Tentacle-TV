+ */
+
+// Vulkan (MoltenVK) context rendering into a CAMetalLayer owned by the host
+// application. --wid is the CAMetalLayer pointer. mpv creates no window and
+// touches no AppKit object; the host owns the layer, its view and its place
+// in the layer tree. The drawable size comes from --moltenvk-surface-size
+// (falling back to the layer's drawableSize). Colorspace, EDR and HDR
+// metadata are set on the layer by MoltenVK when libplacebo picks the
+// swapchain color space (see --target-colorspace-hint).
+
+#import <QuartzCore/QuartzCore.h>
+
+#include "options/options.h"
+#include "video/out/gpu/context.h"
+
+#include "common.h"
+#include "context.h"
+#include "utils.h"
+
+struct priv {
+    struct mpvk_ctx vk;
+    CAMetalLayer *layer;
+};
+
+static void moltenvk_uninit(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+
+    ra_vk_ctx_uninit(ctx);
+    mpvk_uninit(&p->vk);
+    if (p->layer)
+        CFRelease((__bridge CFTypeRef)p->layer);
+    p->layer = nil;
+}
+
+static bool moltenvk_init(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv = talloc_zero(ctx, struct priv);
+    struct mpvk_ctx *vk = &p->vk;
+    int msgl = ctx->opts.probing ? MSGL_V : MSGL_ERR;
+
+    int64_t wid = ctx->vo->opts->WinID;
+    if (wid <= 0) {
+        MP_MSG(ctx, msgl, "moltenvk: --wid must be a CAMetalLayer pointer\n");
+        goto error;
+    }
+    id obj = (__bridge id)(void *)(intptr_t)wid;
+    if (![obj isKindOfClass:[CAMetalLayer class]]) {
+        MP_MSG(ctx, msgl, "moltenvk: --wid is not a CAMetalLayer\n");
+        goto error;
+    }
+    p->layer = obj;
+    CFRetain((__bridge CFTypeRef)p->layer);
+
+    if (!mpvk_init(vk, ctx, VK_EXT_METAL_SURFACE_EXTENSION_NAME))
+        goto error;
+
+    VkMetalSurfaceCreateInfoEXT info = {
+        .sType = VK_STRUCTURE_TYPE_METAL_SURFACE_CREATE_INFO_EXT,
+        .pLayer = p->layer,
+    };
+
+    VkInstance inst = vk->vkinst->instance;
+    VkResult res = vkCreateMetalSurfaceEXT(inst, &info, NULL, &vk->surface);
+    if (res != VK_SUCCESS) {
+        MP_MSG(ctx, msgl, "moltenvk: failed creating Metal surface\n");
+        goto error;
+    }
+
+    struct ra_ctx_params params = {0};
+    if (!ra_vk_ctx_init(ctx, vk, params, VK_PRESENT_MODE_FIFO_KHR))
+        goto error;
+
+    MP_VERBOSE(ctx, "moltenvk: rendering into host CAMetalLayer %p\n",
+               (__bridge void *)p->layer);
+    return true;
+error:
+    moltenvk_uninit(ctx);
+    return false;
+}
+
+static bool moltenvk_surface_size(struct ra_ctx *ctx, int *w, int *h)
+{
+    struct priv *p = ctx->priv;
+    struct m_geometry *g = &ctx->vo->opts->moltenvk_surface_size;
+    *w = g->w;
+    *h = g->h;
+    if (*w <= 0 || *h <= 0) {
+        CGSize size = p->layer.drawableSize;
+        *w = (int)size.width;
+        *h = (int)size.height;
+    }
+    return *w > 0 && *h > 0;
+}
+
+static bool moltenvk_reconfig(struct ra_ctx *ctx)
+{
+    int w, h;
+    if (!moltenvk_surface_size(ctx, &w, &h)) {
+        MP_ERR(ctx, "moltenvk: unknown surface size, set --moltenvk-surface-size\n");
+        return false;
+    }
+    return ra_vk_ctx_resize(ctx, w, h);
+}
+
+static int moltenvk_control(struct ra_ctx *ctx, int *events, int request, void *arg)
+{
+    return VO_NOTIMPL;
+}
+
+const struct ra_ctx_fns ra_ctx_vulkan_moltenvk = {
+    .type           = "vulkan",
+    .name           = "moltenvk",
+    .description    = "Vulkan (MoltenVK) into a host CAMetalLayer (--wid)",
+    .reconfig       = moltenvk_reconfig,
+    .control        = moltenvk_control,
+    .init           = moltenvk_init,
+    .uninit         = moltenvk_uninit,
+};
