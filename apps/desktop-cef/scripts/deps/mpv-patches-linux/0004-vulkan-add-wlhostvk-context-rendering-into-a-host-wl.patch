+
+// Vulkan context rendering into a wl_surface owned by the host application
+// (typically a wl_subsurface placed below the host's own surface). --wid is a
+// pointer to a struct mpv_wlhost_target (below) living in the host process.
+// mpv opens no Wayland connection, creates no window, binds no global and
+// handles no input: the host owns the surface, its role, its position, its
+// scale and its viewport. The swapchain size comes from
+// --wlhostvk-surface-size. HDR goes through the Vulkan WSI: when libplacebo
+// picks an HDR swapchain color space (see --target-colorspace-hint), the
+// driver describes the surface to the compositor (color-management-v1).
+
+#include <stdint.h>
+
+#include <wayland-client.h>
+
+#include "options/options.h"
+#include "video/out/gpu/context.h"
+
+#include "common.h"
+#include "context.h"
+#include "utils.h"
+
+#define MPV_WLHOST_MAGIC 0x574c4854u /* "THLW" */
+
+// Must match the host's definition (version 1).
+struct mpv_wlhost_target {
+    uint32_t magic;
+    uint32_t version;
+    struct wl_display *display;
+    struct wl_surface *surface;
+};
+
+struct priv {
+    struct mpvk_ctx vk;
+};
+
+static void wlhost_uninit(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+
+    ra_vk_ctx_uninit(ctx);
+    mpvk_uninit(&p->vk);
+}
+
+static bool wlhost_init(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv = talloc_zero(ctx, struct priv);
+    struct mpvk_ctx *vk = &p->vk;
+
+    // Never auto-probed: --wid would be read as a pointer.
+    if (ctx->opts.probing)
+        goto error;
+
+    int64_t wid = ctx->vo->opts->WinID;
+    const struct mpv_wlhost_target *t = (const void *)(intptr_t)wid;
+    if (wid <= 0 || t->magic != MPV_WLHOST_MAGIC || t->version < 1 ||
+        !t->display || !t->surface)
+    {
+        MP_ERR(ctx, "wlhostvk: --wid must point to a struct mpv_wlhost_target\n");
+        goto error;
+    }
+
+    if (!mpvk_init(vk, ctx, VK_KHR_WAYLAND_SURFACE_EXTENSION_NAME))
+        goto error;
+
+    VkWaylandSurfaceCreateInfoKHR info = {
+        .sType   = VK_STRUCTURE_TYPE_WAYLAND_SURFACE_CREATE_INFO_KHR,
+        .display = t->display,
+        .surface = t->surface,
+    };
+    VkResult res = vkCreateWaylandSurfaceKHR(vk->vkinst->instance, &info, NULL,
+                                             &vk->surface);
+    if (res != VK_SUCCESS) {
+        MP_ERR(ctx, "wlhostvk: failed creating Wayland surface\n");
+        goto error;
+    }
+
+    // MAILBOX: a hidden surface gets no frame callbacks, and FIFO would block
+    // the VO thread until it is shown again (see context_wayland.c).
+    struct ra_ctx_params params = {0};
+    if (!ra_vk_ctx_init(ctx, vk, params, VK_PRESENT_MODE_MAILBOX_KHR))
+        goto error;
+
+    ra_add_native_resource(ctx->ra, "wl", t->display);
+    MP_VERBOSE(ctx, "wlhostvk: rendering into host wl_surface %p\n",
+               (void *)t->surface);
+    return true;
+
+error:
+    wlhost_uninit(ctx);
+    return false;
+}
+
+static bool wlhost_reconfig(struct ra_ctx *ctx)
+{
+    struct m_geometry *g = &ctx->vo->opts->wlhostvk_surface_size;
+    if (g->w <= 0 || g->h <= 0) {
+        MP_ERR(ctx, "wlhostvk: unknown surface size, set --wlhostvk-surface-size\n");
+        return false;
+    }
+    return ra_vk_ctx_resize(ctx, g->w, g->h);
+}
+
+// VOCTRL_EXTERNAL_RESIZE is handled by the VO itself (reconfig).
+static int wlhost_control(struct ra_ctx *ctx, int *events, int request, void *arg)
+{
+    return VO_NOTIMPL;
+}
+
+const struct ra_ctx_fns ra_ctx_vulkan_wlhost = {
+    .type           = "vulkan",
+    .name           = "wlhostvk",
+    .description    = "Wayland/Vulkan into a host wl_surface (--wid)",
+    .reconfig       = wlhost_reconfig,
+    .control        = wlhost_control,
+    .init           = wlhost_init,
+    .uninit         = wlhost_uninit,
+};
