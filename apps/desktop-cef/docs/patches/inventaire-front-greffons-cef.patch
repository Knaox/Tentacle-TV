+    if (!shellServesPluginDocuments() || html === null) return;
     let cancelled = false;
     setSrc(null);
     void invoke<string | null>("plugin_document_set", { id: pluginId, html })
@@ -48,6 +60,6 @@ export function usePluginMount(pluginId: string, html: string | null): PluginMou
   }, [pluginId, html]);
 
   if (html === null) return null;
-  if (!isElectronShell()) return { srcDoc: html };
+  if (!shellServesPluginDocuments()) return { srcDoc: html };
   return src === null ? null : { src };
 }
