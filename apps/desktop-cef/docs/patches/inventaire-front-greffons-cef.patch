 import { useEffect, useState } from "react";
 import { invoke, isElectronShell } from "./bridge";
 
+/**
+ * La coquille sert-elle les greffons sous leur origine à elle ?
+ *
+ * La capacité, pas seulement la coquille : une coquille qui pose
+ * `window.tentacle` sans `plugin_document_set` (Tentacle CEF, qui charge la
+ * page DEPUIS le serveur, sous sa politique) laissait l'iframe vide et le
+ * chargeur affiché pour toujours — le rejet de `invoke` était avalé.
+ */
+function shellServesPluginDocuments(): boolean {
+  return isElectronShell() && (window.tentacle?.capabilities.includes("plugin_document_set") ?? false);
+}
+
 /** Attributs de montage : l'un des deux est défini, jamais les deux. */
 export interface PluginMount {
   /** Electron : URL servie sous l'origine des greffons. */
