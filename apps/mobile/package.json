{
  "name": "@tentacle-tv/mobile",
  "version": "1.2.4",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:ios": "eas build --platform ios --profile production",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:android": "eas build --platform android --profile production",
    "build:android:preview": "eas build --platform android --profile preview",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "postinstall": "node -e \"['@tanstack/react-query','@tanstack/query-core','react-native-reanimated'].forEach(p=>{try{const f=require.resolve(p+'/package.json');const j=JSON.parse(require('fs').readFileSync(f,'utf8'));if(j['react-native']){delete j['react-native'];require('fs').writeFileSync(f,JSON.stringify(j,null,2)+'\\n')}}catch{}})\""
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@callstack/liquid-glass": "^0.8.0",
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@tanstack/react-query": "^5.62.0",
    "@tentacle-tv/api-client": "workspace:*",
    "@tentacle-tv/shared": "workspace:*",
    "@tentacle-tv/theme": "workspace:*",
    "expo": "~54.0.0",
    "expo-application": "~7.0.8",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-screen-orientation": "^9.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "i18next": "^25.8.13",
    "lucide-react-native": "^0.577.0",
    "nativewind": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.5.4",
    "react-native": "~0.81.5",
    "react-native-reanimated": "~3.19.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "~15.12.1",
    "react-native-video": "^6.9.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "babel-plugin-module-resolver": "^5.0.2",
    "react-native-css-interop": "~0.1.22",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
