{
  "expo": {
    "name": "Tentacle TV",
    "slug": "tentacle-mobile",
    "version": "1.0.0",
    "description": "Tentacle TV is a premium media client for self-hosted media servers. Stream your movies, series, and music from your personal library with a beautiful, native iOS experience.",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "tentacle",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080812"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tentacle.mobile",
      "buildNumber": "47",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio",
          "remote-notification"
        ],
        "AVInitialRouteSharingPolicy": "LongFormVideo",
        "NSLocalNetworkUsageDescription": "Tentacle TV needs access to your local network to connect to your self-hosted media server.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080812"
      },
      "package": "com.tentacletv.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-screen-orientation",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#080812"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9ec680e1-8591-44c4-98e0-79867fac32ca"
      },
      "minServer": "1.5.0"
    }
  }
}
