<?xml version="1.0" encoding="utf-8"?>

<!--
  Sauvegarde automatique et transfert d'appareil, Android 12 et après. Mêmes
  règles que `offline_backup_rules.xml` : préférences gardées, SecureStore et
  titres hors ligne (`files/offline`) écartés.
-->
<data-extraction-rules>
  <cloud-backup>
    <include domain="sharedpref" path="."/>
    <exclude domain="sharedpref" path="SecureStore"/>
    <exclude domain="file" path="offline"/>
  </cloud-backup>
  <device-transfer>
    <include domain="sharedpref" path="."/>
    <exclude domain="sharedpref" path="SecureStore"/>
    <exclude domain="file" path="offline"/>
  </device-transfer>
</data-extraction-rules>
