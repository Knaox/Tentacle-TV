<?xml version="1.0" encoding="utf-8"?>

<!--
  Sauvegarde automatique et transfert d'appareil, Android 12 et après. Mêmes
  règles que `offline_backup_rules.xml` : préférences gardées, SecureStore
  écarté, et les titres hors ligne (`files/offline`) hors sauvegarde du seul
  fait qu'aucun `<include>` ne nomme le domaine `file` — voir le commentaire
  de l'autre fichier, le lint refuse de l'écrire autrement.
-->
<data-extraction-rules>
  <cloud-backup>
    <include domain="sharedpref" path="."/>
    <exclude domain="sharedpref" path="SecureStore"/>
  </cloud-backup>
  <device-transfer>
    <include domain="sharedpref" path="."/>
    <exclude domain="sharedpref" path="SecureStore"/>
  </device-transfer>
</data-extraction-rules>
