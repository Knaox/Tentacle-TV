<?xml version="1.0" encoding="utf-8"?>
<!--
  Réduction des ressources (android.enableShrinkResourcesInReleaseBuilds) :
  les images que le bundle JavaScript embarque (drawable-*, raw) ne sont
  nommées que dans ce bundle, jamais dans le code Java — le réducteur les
  croirait inutilisées. On les garde toutes ; il ne retire que les ressources
  des bibliothèques que rien n'appelle.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/*,@raw/*" />
