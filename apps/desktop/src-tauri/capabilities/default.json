{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "process:default",
    "opener:default",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "http://**"
        },
        {
          "url": "https://**"
        },
        {
          "url": "mailto:*"
        },
        {
          "url": "tel:*"
        },
        {
          "url": "macappstore:*"
        },
        {
          "url": "macappstore://**"
        },
        {
          "url": "itms-apps:*"
        },
        {
          "url": "itms-apps://**"
        },
        {
          "url": "ms-windows-store:*"
        },
        {
          "url": "ms-windows-store://**"
        }
      ]
    }
  ]
}
