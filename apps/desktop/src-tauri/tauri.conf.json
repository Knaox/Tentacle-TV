{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Tentacle TV",
  "version": "1.20.8",
  "identifier": "com.tentacle.media",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "",
    "beforeBuildCommand": "pnpm --filter @tentacle-tv/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Tentacle TV",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' blob: data: https: http: http://127.0.0.1:*; media-src 'self' blob: https: http:; connect-src 'self' https: http: ws: wss: http://ipc.localhost ipc: http://127.0.0.1:*; font-src 'self' https://fonts.gstatic.com; frame-src 'self' blob: data: http: https:; child-src 'self' blob: data: http: https:; object-src 'none'; base-uri 'self'; form-action 'self';",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "publisher": "Damien ROUGE",
    "resources": [
      "lib/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "Developer ID Application: Damien ROUGE (96K3M57W49)",
      "entitlements": "./Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "libmpv2 | libmpv1",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      },
      "rpm": {
        "depends": [
          "mpv-libs",
          "webkit2gtk4.1",
          "gtk3",
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free",
          "gstreamer1-libav"
        ]
      }
    }
  }
}
