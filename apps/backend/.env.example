# Jellyfin Admin
JELLYFIN_URL=http://localhost:8096
JELLYFIN_ADMIN_API_KEY=your_admin_api_key_here

# Base de données : rien à régler. Le serveur garde ses données dans
# data/tentacle.db (SQLite), qu'il crée et met à jour lui-même au démarrage.
# DATABASE_URL / DB_HOST ne servent plus qu'à MIGRER une ancienne MariaDB
# (serveur 1.25) : posés ici, le serveur de dev tenterait cette migration.

# Server
PORT=3001

# Limites de débit, par minute et par IP — DEUX compteurs séparés
# (cf. services/rateLimitPolicy.ts). Les images se comptent à part : une grille
# de bibliothèque demande une vignette par affiche, ce volume n'a rien à voir
# avec celui des appels d'API et ne doit pas les affamer.
# RATE_LIMIT=1000
# RATE_LIMIT_IMAGES=6000

# CORS
CORS_ORIGIN=http://localhost:5173

# Notifications push — hors production (NODE_ENV≠production), l'envoi est COUPÉ :
# le backend de dev lit le même Jellyfin que la prod, chaque ajout partirait
# vers les vrais téléphones inscrits dans la base locale. Le bouton « notification
# de test » (admin) passe quand même. Mettre à 1 pour rouvrir l'envoi en dev.
# TENTACLE_DEV_PUSH=1

# Dossier de données (la base tentacle.db, les extensions). Défaut : apps/backend/data.
# TENTACLE_DATA_DIR=/chemin/vers/data

# Jumelage de provisionnement (code admin long pour le passage de la TV dans les stores)
# Secret partagé backend <-> worker relay Cloudflare (doit être identique des deux côtés).
RELAY_ADMIN_SECRET=change_this_to_a_long_random_string
# Optionnel : surcharge de l'URL du relay de jumelage (défaut : https://pair.tentacletv.app)
# PAIRING_RELAY_URL=https://pair.tentacletv.app

# Client téléviseur (LG webOS), servi sous /tv
# En production, /tv n'est servi qu'aux agents qui disent venir d'un téléviseur
# (« Web0S », avec un zéro). Ce n'est PAS un contrôle d'accès — un en-tête se
# falsifie — mais une adresse qu'on ne donne pas : le client exige de toute
# façon un jeton d'appareil ou un cookie de session.
# Mettre à 1 pour l'ouvrir à n'importe quel navigateur, le temps d'un essai.
# Hors production, il est ouvert sans condition.
# TENTACLE_TV_OUVERT=1

# Mise à jour du serveur (carte « Serveur Tentacle » de la vue d'ensemble).
# La dernière version publiée est lue sur GitHub au plus toutes les six heures ;
# `off` coupe la vérification (installation isolée). Le serveur ne parle JAMAIS à
# Docker : la carte donne la commande à copier.
# TENTACLE_SERVER_UPDATE_REPO=off
# L'image déployée, pour une commande exacte quand l'étiquette est figée :
# TENTACLE_IMAGE=ghcr.io/knaox/tentacle-tv:v1.22.3
# Forcer la détection du conteneur (docker, podman, none) là où elle échoue :
# TENTACLE_INSTALL_RUNTIME=docker
