{
  "name": "@tentacle-tv/backend",
  "version": "1.40.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "cross-env WT_DEBUG=1 tsx watch --ignore './data/**' src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json && tsc --noEmit -p test/jellyfin-compat/tsconfig.json",
    "lint": "eslint src/",
    "test": "vitest run",
    "bench:notifications": "tsx test/notif-e2e/run.ts",
    "bench:reco": "tsx --env-file=.env test/reco-bench/run.ts",
    "bench:parental": "tsx test/parental-bench/run.ts",
    "test:jellyfin-compat": "tsx test/jellyfin-compat/run.ts",
    "db:generate": "prisma generate",
    "db:migration": "tsx scripts/new-sqlite-migration.ts",
    "db:studio": "prisma studio",
    "build:shared-deps": "node scripts/build-shared-deps.js"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@prisma/client": "^6.19.3",
    "expo-server-sdk": "^6.1.0",
    "fastify": "^5.12.2",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.2",
    "mariadb": "^3.5.4",
    "minisearch": "^7.2.0",
    "undici": "^6.29.1",
    "ws": "^8.21.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.90.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/ws": "^8.18.2",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "i18next": "^25.10.10",
    "prisma": "^6.19.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
