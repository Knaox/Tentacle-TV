generator client {
  provider = "prisma-client-js"
}

// La base est un fichier SQLite du dossier de données (`data/tentacle.db`) ;
// le serveur en tire l'URL lui-même (services/database/sqlitePath.ts) et
// n'utilise jamais celle-ci, qui ne sert qu'aux outils Prisma en développement.
// Le schéma se pose par les migrations versionnées de `migrations-sqlite/`
// (docs/sqlite/DECISION.md) — jamais `prisma db push` : il supprimerait les
// tables des extensions.
datasource db {
  provider = "sqlite"
  url      = "file:../data/tentacle.db"
}

model InviteKey {
  id          String    @id @default(cuid())
  key         String    @unique
  maxUses     Int       @default(1)
  currentUses Int       @default(0)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  createdBy   String?
  usages      InviteUsage[]

  @@index([key])
  @@map("invite_keys")
}

model InviteUsage {
  id            String    @id @default(cuid())
  inviteKeyId   String
  inviteKey     InviteKey @relation(fields: [inviteKeyId], references: [id])
  jellyfinUserId String
  username      String
  usedAt        DateTime  @default(now())

  @@map("invite_usages")
}

model SupportTicket {
  id              String    @id @default(cuid())
  jellyfinUserId  String
  username        String
  subject         String
  category        String    @default("general") // general | bug | feature | account
  status          String    @default("open")     // open | in_progress | resolved | closed
  mediaItemId     String?    // Jellyfin item ID (episode/movie)
  mediaItemName   String?    // e.g. "Breaking Bad — S1E3 — ...And the Bag's in the River"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  messages        TicketMessage[]

  @@index([jellyfinUserId])
  @@index([status])
  @@map("support_tickets")
}

model TicketMessage {
  id              String    @id @default(cuid())
  ticketId        String
  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  jellyfinUserId  String
  username        String
  isAdmin         Boolean   @default(false)
  body            String
  createdAt       DateTime  @default(now())

  @@index([ticketId])
  @@map("ticket_messages")
}

// La cloche. Une ligne supprimée par l'utilisateur quitte la base aussitôt ;
// les autres sont purgées au-delà de 30 jours (services/notificationPurge.ts).
model Notification {
  id              String    @id @default(cuid())
  jellyfinUserId  String
  type            String     // ticket_reply | ticket_status | request_status
  title           String
  body            String?
  refId           String?   // ticket or request ID
  /// Où mène la notification (JSON du contrat `notifications/notificationTarget.ts`) ;
  /// null = la route tirée du type, comme avant. Posée par l'émetteur (cœur ou extension).
  target          String?
  /// L'état de ce dont elle parle (`NOTIFICATION_STATES`) ; null = pas de pastille.
  state           String?
  read            Boolean   @default(false)
  createdAt       DateTime  @default(now())
  pushedAt        DateTime? // horodatage de livraison push (null = pas encore poussée)

  @@index([jellyfinUserId, read])
  @@index([type, pushedAt])
  @@map("notifications")
}

// Jeton de push Expo d'un appareil mobile, rattaché à un utilisateur Jellyfin.
// Alimenté par POST /api/push/register ; purgé quand Expo renvoie
// « DeviceNotRegistered ». Indépendant du jumelage TV (PairedDevice).
model PushDevice {
  id              String   @id @default(cuid())
  jellyfinUserId  String
  expoPushToken   String   @unique
  platform        String   // ios | android
  lastSeen        DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([jellyfinUserId])
  @@map("push_devices")
}

// Préférences de notifications push par utilisateur. libraryAdded = tous les
// ajouts bibliothèque, opt-in (false). seerAvailable = ses demandes arrivées
// dans la bibliothèque : ACTIVÉE par défaut (1.19.1), on veut savoir quand
// arrive ce qu'on a demandé. tickets = vie des tickets de support (réponse,
// statut, et nouveaux tickets pour les admins) : ACTIVÉE par défaut, c'est une
// conversation directe. Une ligne absente vaut les défauts de chaque clé
// (services/pushPreferences.ts), pas « tout off ».
model NotificationPreference {
  jellyfinUserId  String   @id
  libraryAdded    Boolean  @default(false)
  seerAvailable   Boolean  @default(true)
  tickets         Boolean  @default(true)
  /// La Famille : les invitations reçues. ACTIVÉE par défaut (docs/FAMILLE.md).
  family          Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  @@map("notification_preferences")
}

model LibraryPreference {
  id              String  @id @default(cuid())
  jellyfinUserId  String
  libraryId       String
  audioLang       String?   // ISO 639-2/B code
  subtitleLang    String?
  subtitleMode    String  @default("none") // "none" | "always" | "forced" | "signs"

  @@unique([jellyfinUserId, libraryId])
  @@index([jellyfinUserId])
  @@map("library_preferences")
}

// Langues retenues pour UN contenu précis — un film, un épisode.
//
// Écrite automatiquement dès que l'utilisateur change de piste depuis les
// réglages du lecteur, et relue en priorité au visionnage suivant du MÊME
// contenu : elle bat la préférence de saison, de série et de bibliothèque.
//
// Table à part et non une ligne de plus dans `LibraryPreference`, dont le
// `libraryId` accepterait pourtant n'importe quelle chaîne : `GET
// /api/preferences` rend TOUTES les lignes de l'utilisateur — la page
// Préférences et le cache hors ligne les lisent — et une ligne par épisode
// regardé y aurait fait grossir sans bornes une réponse qui doit rester la
// liste des bibliothèques.
model ItemTrackPreference {
  id              String   @id @default(cuid())
  jellyfinUserId  String
  itemId          String
  // Des LANGUES, jamais des index de piste : ceux des pistes externes sont
  // décalés de +1000 côté lecture locale, et ceux de Jellyfin changent entre
  // lecture directe et transcodage.
  audioLang       String?
  subtitleLang    String?
  subtitleMode    String   @default("none") // "none" | "always" | "forced" | "signs"
  updatedAt       DateTime @updatedAt

  @@unique([jellyfinUserId, itemId])
  @@index([jellyfinUserId])
  @@map("item_track_preferences")
}

model ServerConfig {
  key   String @id
  value String

  @@map("server_config")
}

// Revendication GÉNÉRIQUE de contenu par un plugin (ex. Seer) : tant qu'un claim
// non expiré existe pour (tmdbId, user), cet utilisateur ATTEND ce contenu — le
// notifier d'ajouts bibliothèque lui annonce son arrivée dès que Jellyfin l'a,
// sous la forme « Votre demande est disponible ». Le core reste générique : il
// ne connaît pas le plugin, juste le claim.
model ContentClaim {
  tmdbId          Int
  jellyfinUserId  String
  mediaType       String    // movie | tv
  title           String   // titre normalisé (match épisodes par nom de série)
  expiresAt       DateTime

  @@id([tmdbId, jellyfinUserId])
  @@index([expiresAt])
  @@map("content_claims")
}

// Instantané PERSISTANT des IDs d'items bibliothèque (Movie/Series/Episode) pour
// la détection d'ajouts par diff, robuste aux redémarrages (rattrape les ajouts
// faits pendant une coupure). Un item = une ligne.
// contentKey : le CONTENU que l'item porte (film par TMDB, épisode par série +
// numéros) — '' quand il n'en porte pas, NULL tant qu'il n'est pas reconnu.
// removedAt : l'item a quitté la bibliothèque ; la ligne reste 30 jours, le
// temps de reconnaître un fichier REMPLACÉ (mise à niveau, déplacement) d'une
// vraie nouveauté. Voir services/libraryPresence.ts.
model LibraryKnownId {
  itemId      String    @id
  contentKey  String?
  removedAt   DateTime?

  @@index([contentKey])
  @@map("library_known_id")
}

// Registre PERSISTANT des annonces push par (clé de contenu, utilisateur),
// consulté et alimenté par LES DEUX pipelines (notifier bibliothèque + worker
// Seer) au moment de l'envoi : un contenu annoncé à un utilisateur ne l'est
// JAMAIS deux fois (restart, changement de prefs et pipeline croisé compris).
// Multi-alias : les clés tmdb ET titre normalisé d'un même envoi sont
// enregistrées ensemble (neutralise la résolution TMDB tardive). Purge 30 j.
// Voir services/announcedRegistry.ts pour le format des clés.
model AnnouncedContent {
  contentKey      String
  jellyfinUserId  String
  notifiedAt      DateTime @default(now())

  @@id([contentKey, jellyfinUserId])
  @@index([notifiedAt])
  @@map("announced_contents")
}

// Séries retirées AUTOMATIQUEMENT de « Ma liste » (tout le disponible vu) :
// à remettre dès qu'un épisode (saison > 0) de la série entre en bibliothèque.
// Écrite par le client au retrait automatique ; effacée par le serveur à la
// remise, ou par le client dès que l'utilisateur reprend la main (ajout ou
// retrait manuel — son geste prime, la série ne revient plus toute seule).
// Une série retirée À LA MAIN n'a jamais de ligne ici.
// Voir services/watchlistAutoRetired.ts et routes/watchlist.ts.
model WatchlistAutoRetired {
  seriesId       String
  jellyfinUserId String
  retiredAt      DateTime @default(now())

  @@id([seriesId, jellyfinUserId])
  @@index([jellyfinUserId])
  @@map("watchlist_auto_retired")
}

// Ce qu'un titre qui n'est PAS encore dans la bibliothèque attend pour être
// posé chez Jellyfin, compte par compte, un drapeau par ligne :
//   • « watchlist » — Ma liste (Likes Jellyfin), posée depuis une carte hors
//     bibliothèque (recommandation, recherche, extension de demandes) ;
//   • « favorite »  — J'aime (le cœur, IsFavorite), donné dans « Affiner ».
// Le serveur pose le drapeau dès que le titre arrive, puis efface la ligne —
// voir services/watchlistPending.ts. Clé TMDB : c'est la seule identité d'un
// titre absent. mediaType au vocabulaire TMDB (« movie » | « tv »).
model WatchlistPending {
  jellyfinUserId String
  mediaType      String
  tmdbId         Int
  /// « watchlist » | « favorite » (cf. PendingFlag).
  flag           String   @default("watchlist")
  createdAt      DateTime @default(now())

  @@id([jellyfinUserId, mediaType, tmdbId, flag])
  @@index([mediaType, tmdbId])
  @@map("watchlist_pending")
}

model PairingCode {
  id                    String    @id @default(cuid())
  code                  String    @unique
  status                String    @default("pending")
  deviceName            String?
  deviceId              String?
  jellyfinUserId        String?
  username              String?
  token                 String?
  jellyfinAccessToken   String?
  createdAt             DateTime  @default(now())
  expiresAt             DateTime

  @@index([expiresAt])
  @@map("pairing_codes")
}

// Code de jumelage de provisionnement (singleton) — code long, réutilisable
// sans limite d'usages, pensé pour le passage de la TV dans les stores (un
// testeur tape le code → jumelage immédiat sur le serveur public, compte dédié).
// Désactivé par défaut ; activé avec une date d'expiration OBLIGATOIRE après
// laquelle il est invalide ET l'option se désactive automatiquement (safe).
// Transport via le relay Cloudflare (entrée pré-confirmée persistante).
model ProvisioningCode {
  id                    String    @id @default(cuid())
  code                  String    @unique
  enabled               Boolean   @default(false)
  expiresAt             DateTime?
  jellyfinUserId        String?
  username              String?
  jellyfinAccessToken   String?
  token                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("provisioning_codes")
}

model PairedDevice {
  id                    String    @id @default(cuid())
  name                  String
  jellyfinUserId        String
  username              String
  tokenHash             String    @unique
  jellyfinAccessToken   String?
  /// L'appareil Jellyfin dont `jellyfinAccessToken` est le jeton PROPRE, frappé
  /// pour cette TV (Quick Connect). Nul : jumelage d'avant — jeton copié d'un
  /// autre appareil du compte, jamais rendu, remplacé au contact suivant.
  jellyfinDeviceId      String?
  lastSeen              DateTime  @default(now())
  createdAt             DateTime  @default(now())
  /// La Famille (docs/FAMILLE.md). Une SESSION DE PROFIL d'une TV est une
  /// ligne enfant : `parentId` = le jumelage de la TV, `jellyfinUserId` = le
  /// compte du profil, son propre jeton Jellyfin. Nul : un jumelage de TV.
  parentId              String?
  /// Session de profil : `owner` | `member` | `guest`.
  profileKind           String?
  /// Jumelage passé aux profils : son jeton (échangé) ne vaut plus session —
  /// il liste les profils et en ouvre un, rien d'autre.
  profilesSince         DateTime?
  /// L'empreinte du jeton d'avant l'échange, tant que le nouveau n'a pas
  /// servi : une réponse perdue se rejoue, une seule fois.
  legacyTokenHash       String?
  /// « Rester sur ce profil » : le profil que cette TV rouvre sans PIN.
  stickyProfileId       String?
  /// Session du propriétaire : « Gérer les profils » ouvert jusqu'à (PIN).
  manageUntil           DateTime?
  /// La Famille hors des TV (docs/FAMILLE.md, « Le bureau ») : `desktop` — un
  /// HÔTE de profils, la ligne d'un appareil dont la SESSION PERSONNELLE ouvre
  /// les sessions de profil (lignes enfants). Aucun jeton ne la désigne : son
  /// empreinte est dérivée du jeton personnel. Nul : une TV ou un appareil jumelé.
  platform              String?

  @@index([jellyfinUserId])
  @@index([tokenHash])
  @@index([parentId])
  @@index([legacyTokenHash])
  @@map("paired_devices")
}

/// La Famille (docs/FAMILLE.md) : un propriétaire — tout compte du serveur
/// sauf un invité —, une famille au plus.
model Family {
  id          String   @id @default(cuid())
  ownerUserId String   @unique
  /// Dernier nom connu du propriétaire : l'affiche, la cloche, les sessions.
  ownerName   String
  ownerColor  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("families")
}

/// Les personnes d'une famille (v2) : `owner` (le propriétaire — sa ligne
/// porte l'unicité « une famille par compte »), `member` (compte du serveur
/// qui a accepté une invitation ; le retirer ne touche JAMAIS son compte) ou
/// `guest` (compte Jellyfin créé par Tentacle, caché, mot de passe jeté).
model FamilyMember {
  id           String   @id @default(cuid())
  familyId     String
  userId       String
  kind         String
  displayName  String
  color        String?
  /// Invité : le nom de son compte Jellyfin (« Lea - invite de Damien »).
  jellyfinName String?
  /// Invité (v2) : le compte qui l'a créé — le propriétaire, ou un membre
  /// autorisé. Null pour une ligne d'avant la v2 (créée par le propriétaire).
  createdBy       String?
  /// Membre (v2) : le propriétaire lui permet de créer des invités. Coupé par défaut.
  canCreateGuests Boolean  @default(false)
  /// Invité (v2) : « peut demander » — les extensions, à son propre nom. Coupé par défaut.
  canRequestTitles Boolean @default(false)
  /// Invité (1.30.0) : le compte qui a coché « peut demander » — c'est SON droit d'administration
  /// (`grantGuestRequests`) qui le tient en vigueur. Null (ligne d'avant) : son créateur, sinon le propriétaire.
  requestTitlesGrantedBy String?
  /// Invité (1.30.0) : son contrôle parental VOULU (JSON `GuestParentalControls`) ; null = aucun.
  /// La politique EFFECTIVE (recoupée avec son créateur) vit dans Jellyfin.
  parentalControls String?
  createdAt    DateTime @default(now())
  /// Membre (1.30.0) : le propriétaire l'a nommé PARENT — il gère les invités et les membres mineurs.
  isParent     Boolean  @default(false)
  /// Invité (1.30.0) : les bibliothèques que la famille lui permet (JSON, liste d'identifiants) ;
  /// null = toutes celles de son créateur. La politique EFFECTIVE vit dans Jellyfin.
  libraryAccess String?
  /// 1.30.0 (`family.promptsReset`) : « Reproposer le code PIN et la photo » — le premier passage de
  /// ce profil revient sur un appareil qui a retenu « Plus tard » avant cette date. Null : jamais.
  promptsResetAt DateTime?

  @@unique([familyId, userId])
  /// v2 : UNE famille par compte — propriétaire, membre ou invité, une seule ligne.
  @@unique([userId])
  @@map("family_members")
}

/// Le contrôle parental d'un MEMBRE mineur de la Famille (1.30.0), une ligne par compte. Jellyfin porte
/// la politique EFFECTIVE (base ∩ voulu) ; Tentacle garde le VOULU, la BASE — les champs parentaux que
/// règle l'administrateur, rendus à l'identique au retrait — et la DERNIÈRE ÉCRITURE (un champ qui en
/// diffère a été changé ailleurs : il devient la base). `controls` null : retiré, la base reste à rendre
/// (`restorePending`, rejoué par le guet tant que Jellyfin ne l'a pas reprise).
model FamilyMemberParental {
  userId         String   @id
  familyId       String
  /// JSON `GuestParentalControls` ; null = retiré (base à rendre).
  controls       String?
  /// JSON `GuestParentalCeiling` : les champs parentaux de la politique de base.
  base           String
  /// JSON `GuestParentalCeiling` : la politique effective relue après la dernière écriture.
  written        String?
  restorePending Boolean  @default(false)
  /// JSON : les bibliothèques voulues par la famille (liste d'identifiants) ; null = toutes celles de la base.
  libraries      String?
  /// JSON `{ all, ids }` : les bibliothèques de la base (celles de l'administrateur) ; null = pas encore relevées.
  libraryBase    String?
  /// JSON `{ all, ids }` : les bibliothèques relues après la dernière écriture.
  libraryWritten String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([familyId])
  @@map("family_member_parental")
}

/// Les droits de création d'un compte (1.30.0) — fonder une famille, créer des invités — réglés par
/// l'administration : `inherit` (le défaut du serveur), `allow` ou `deny`. Sans ligne : `inherit`.
model FamilyAccountRights {
  userId       String   @id
  createFamily String   @default("inherit")
  createGuests String   @default("inherit")
  /// 1.30.0 : autoriser ses invités à demander des films (`inherit` : le défaut, NON).
  grantGuestRequests String @default("inherit")
  updatedAt    DateTime @updatedAt

  @@map("family_account_rights")
}

/// 1.40.0 (`octave.rights`) : les droits TENTACLE d'un compte pour la musique — « Accès à
/// Octave ». Sans ligne : permis (allumé par défaut). Un invité de la Famille vaut son créateur.
model OctaveAccountRights {
  userId    String   @id
  access    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("octave_account_rights")
}

/// Les invitations : identifiant aléatoire de 128 bits (jamais un cuid —
/// personne ne doit pouvoir le deviner), sept jours de validité.
model FamilyInvitation {
  id            String    @id
  familyId      String
  ownerUserId   String
  inviteeUserId String
  inviteeName   String
  /// pending | accepted | declined | cancelled | expired
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  respondedAt   DateTime?
  /// « Plus tard » : l'affiche se tait jusqu'à cette date, la cloche garde.
  snoozedUntil  DateTime?

  @@index([inviteeUserId, status])
  @@index([ownerUserId, createdAt])
  @@index([familyId, status])
  @@map("family_invitations")
}

/// Le code PIN d'un profil (quatre chiffres) — propriétaire, membre ou invité :
/// haché lentement (scrypt, sel propre), jamais rendu, jamais envoyé à une TV.
model ProfilePin {
  userId    String   @id
  pinHash   String
  updatedAt DateTime @updatedAt

  @@map("profile_pins")
}

/// Les essais de PIN ratés d'un profil, toutes TV confondues (changer de TV
/// ne remet pas le compteur à zéro) : cinq, puis un blocage de plus en plus
/// long (`family/familyRules.ts`). Une réussite efface.
model ProfilePinAttempt {
  userId      String    @id
  failures    Int       @default(0)
  lockCount   Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@map("profile_pin_attempts")
}

/// Les appareils Jellyfin frappés pour des TV, à faire disparaître de Jellyfin
/// quand leur jumelage n'est plus — journal qui survit au plantage. `reason` :
/// `minting` (frappe en cours : soldée si la ligne du jumelage le porte) ou
/// `revoked` (jumelage supprimé : `DELETE /Devices` jusqu'à confirmation).
/// Les comptes Jellyfin d'INVITÉS à supprimer (Famille) — un journal DURABLE,
/// comme `paired_device_cleanups` : inscrit dans la transaction qui retire
/// l'invité, soldé quand Jellyfin confirme (ou que le compte n'existe plus),
/// rejoué après chaque échec, au démarrage et à chaque balayage.
model GuestAccountCleanup {
  id             String   @id @default(cuid())
  jellyfinUserId String   @unique
  /// Le nom du compte invité, pour le journal ; null s'il n'est pas connu.
  jellyfinName   String?
  reason         String
  attempts       Int      @default(0)
  lastError      String?
  nextAttemptAt  DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([nextAttemptAt])
  @@map("guest_account_cleanups")
}

model PairedDeviceCleanup {
  id                    String    @id @default(cuid())
  jellyfinDeviceId      String    @unique
  tokenHash             String
  reason                String
  attempts              Int       @default(0)
  nextAttemptAt         DateTime  @default(now())
  createdAt             DateTime  @default(now())

  @@index([nextAttemptAt])
  @@map("paired_device_cleanups")
}

// Lien de partage d'une liste — 1 lien actif par (propriétaire, liste).
// Le lien est Live : à l'ouverture, le backend relit la liste Jellyfin du
// propriétaire (via la clé admin), aucun item n'est stocké ici.
// `kind` est arrivé avec le partage des favoris (colonne et index unique).
// `options` est arrivé avec le partage des statistiques : les réglages du lien,
// en JSON (la période partagée et le fuseau du propriétaire), lus par
// services/share/statsShareOptions.ts ; NULL pour une liste.
model ShareLink {
  id            String   @id @default(cuid())
  token         String   @unique
  ownerUserId   String
  ownerUsername String
  kind          String   @default("watchlist") // "watchlist" | "likes" | "stats"
  options       String?
  createdAt     DateTime @default(now())

  @@unique([ownerUserId, kind])
  @@index([token])
  @@map("share_links")
}

// Un SEGMENT de visionnage : une suite continue de lecture d'UN titre sur UNE
// session Jellyfin. Écrit et prolongé par le collecteur (services/watchTime),
// qui remplace le greffon « Playback Reporting ».
//
// Le temps est MESURÉ par échantillonnage de GET /Sessions toutes les 15 s,
// jamais extrapolé : une coupure du backend laisse un trou, elle n'invente rien.
//
// `clientName`, `deviceName` et `runtimeSeconds` sont là dès le départ bien que
// rien ne les affiche encore.
model WatchSegment {
  id             String    @id @default(cuid())
  jellyfinUserId String
  sessionKey     String
  itemId         String
  itemType       String
  itemName       String
  seriesId       String?
  seriesName     String?
  clientName     String?
  deviceName     String?
  seconds        Int       @default(0)
  runtimeSeconds Int?
  /// Langue de la piste audio lue (ISO 639-1), relevée dans `/Sessions` —
  /// ce que le spectateur ENTEND. NULL : segment d'avant le relevé, ou piste
  /// inconnue (plusieurs pistes et aucun index rapporté).
  audioLang      String?
  startedAt      DateTime
  lastSeenAt     DateTime
  closedAt       DateTime?

  @@index([jellyfinUserId, startedAt])
  @@index([jellyfinUserId, seriesId])
  @@index([startedAt])
  @@index([sessionKey, itemId, closedAt])
  @@index([closedAt])
  @@map("watch_segments")
}

// Bail d'exclusivité du collecteur de temps : une seule instance mesure à la
// fois. Sans lui, un `pnpm dev` oublié sur la même base doublerait
// silencieusement tous les chiffres.
model WatchTimeLease {
  id        String   @id
  owner     String
  expiresAt DateTime

  @@map("watch_time_lease")
}

// Réglages de lecture d'UN compte : segments (intro/générique/récap/aperçu)
// et enchaînement d'épisode. Ils remplacent les trois clés d'appareil
// (tentacle_auto_skip_intro, tentacle_up_next_card, tentacle_up_next_countdown) :
// ces choix suivent désormais l'utilisateur d'un écran à l'autre.
//
// Nommé PlaybackSettings et non PlaybackSegment* : WatchSegment (temps de
// visionnage, ci-dessus) existe déjà et n'a rien à voir.
//
// Colonnes TYPÉES. Le contrat côté code vit dans src/playback/playbackSettings.ts
// (miroir de shared).
model PlaybackSettings {
  id                   String   @id @default(cuid())
  jellyfinUserId       String   @unique

  introAction          String   @default("auto")
  introCountdown       Boolean  @default(true)
  introDelayMs         Int      @default(5000)
  outroAction          String   @default("button")
  outroCountdown       Boolean  @default(true)
  outroDelayMs         Int      @default(5000)
  /// Générique de fin d'un FILM — réglé à part de celui des épisodes, où la
  /// fiche « à suivre » occupe déjà le générique (`playbackSettings.ts`).
  outroFilmAction      String   @default("auto")
  outroFilmCountdown   Boolean  @default(true)
  outroFilmDelayMs     Int      @default(5000)
  recapAction          String   @default("button")
  recapCountdown       Boolean  @default(true)
  recapDelayMs         Int      @default(5000)
  previewAction        String   @default("auto")
  previewCountdown     Boolean  @default(true)
  previewDelayMs       Int      @default(5000)

  nextCard             Boolean  @default(true)
  nextCountdown        Boolean  @default(true)
  /// Durée du compte à rebours « épisode suivant ». Un PLAFOND : le moteur le
  /// raccourcit quand la fin du média approche (`autoNextEngine.ts`).
  nextCountdownMs      Int      @default(10000)
  nextAutoPlay         Boolean  @default(true)
  /// L'affiche PLEIN ÉCRAN de fin d'épisode — indépendante de `nextCard` :
  /// refuser la fiche du générique n'éteint pas l'affiche de fin.
  nextFinalCard        Boolean  @default(true)
  nextTrigger          String   @default("outroStart")
  /// CONSERVÉE : un serveur d'avant la démarre en NOT NULL. Plus lue.
  nextBeforeEndSeconds Int      @default(45)

  /// Le repli « avant la fin » : actif, seuil global, et les règles ciblées.
  /// Les règles sont un JSON — un tableau de longueur variable n'a pas sa
  /// place en colonnes, et rien ne les interroge en SQL.
  beforeEndEnabled     Boolean  @default(true)
  beforeEndMode        String   @default("percent")
  beforeEndValue       Int      @default(98)
  /// NULLABLE : null = aucune règle.
  beforeEndRules       String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("playback_settings")
}

/// Ce que l'analyse de FIN DE MÉDIA a trouvé : début du générique, scènes qui
/// le suivent (services/tailAnalysis/). La table garde le nom de l'analyse des
/// vignettes dont elle prend la suite ; `version` périme les lignes d'avant.
///
/// Une ligne par média, et SEULEMENT quand l'analyse a trouvé quelque chose :
/// le « rien » ne pèse pas sur le serveur (refroidissement en mémoire). Les
/// lignes sans verdict et les versions périmées sont purgées au démarrage.
/// `runtimeMs` est le témoin du fichier : une durée différente, un autre fichier.
model MediaFrameAnalysis {
  itemId    String   @id
  /// Version de l'algorithme (`TAIL_ANALYSIS_VERSION`) : la faire monter
  /// périme toutes les lignes sans avoir à les effacer.
  version   Int
  runtimeMs Int
  /// Le verdict sérialisé (`TailVerdict`). Nullable pour les lignes d'avant ;
  /// on n'en écrit plus de nulles.
  verdict   String?
  createdAt DateTime @default(now())

  @@map("media_frame_analysis")
}

// ─────────────────────────────────────────────────────────────────────────────
// Moteur de recommandation. Doctrine commune à tous les modèles ci-dessous :
// - aucun enum, aucun Json — unions en String commenté, JSON en String ;
// - identité média = (mediaType, tmdbId), la clé canonique de Vigie ("movie:603").
// ─────────────────────────────────────────────────────────────────────────────

// Note explicite d'un titre, sur 10 (1 = une demi-étoile, jamais 0).
// `seasonNumber`/`episodeNumber` valent 0 hors épisode : un index unique admet
// plusieurs NULL, 0 rend l'unicité réelle.
// La note est écrite ici IMMÉDIATEMENT ; la sync TMDB est asynchrone
// (services/reco/syncWorkers.ts) et `syncStatus` en reflète l'état — l'UI ne
// bloque jamais dessus, une note posée hors ligne part à la reconnexion.
model UserRating {
  id              String    @id @default(cuid())
  jellyfinUserId  String
  mediaType       String    // "movie" | "series" | "episode"
  tmdbId          Int
  jellyfinItemId  String?
  seasonNumber    Int       @default(0)
  episodeNumber   Int       @default(0)
  score           Int // 1..10
  syncStatus      String    @default("pending") // "pending" | "synced" | "failed" | "disabled" | "delete_pending"
  syncAttempts    Int       @default(0)
  nextSyncAt      DateTime?
  tmdbSyncedAt    DateTime?
  /// Retrait « doux » : une note déjà poussée chez TMDB doit y être
  /// EFFACÉE avant que la ligne disparaisse — le worker traite `delete_pending`
  /// puis supprime. Une note jamais synchronisée se supprime directement.
  /// Toute lecture (profil, exclusions, UI) ignore `deletedAt != null`.
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // `map:` : nom figé depuis MariaDB (64 caractères au plus), repris tel quel.
  @@unique([jellyfinUserId, mediaType, tmdbId, seasonNumber, episodeNumber], map: "user_ratings_identity_key")
  @@index([jellyfinUserId])
  @@index([syncStatus, nextSyncAt])
  @@map("user_ratings")
}

// « J'aime » d'un titre HORS bibliothèque (catalogue Vigie) : Jellyfin ne peut
// pas porter IsFavorite pour un média qu'il n'a pas. En bibliothèque, le like
// RESTE IsFavorite chez Jellyfin — la vue unifiée vit dans services/reco.
model UserLike {
  id             String   @id @default(cuid())
  jellyfinUserId String
  mediaType      String   // "movie" | "series"
  tmdbId         Int
  createdAt      DateTime @default(now())

  @@unique([jellyfinUserId, mediaType, tmdbId])
  @@index([jellyfinUserId])
  @@map("user_likes")
}

// Profil de goût : vecteur de facettes pondérées, construit par
// services/reco/profileBuilder.ts (incrémental, poké par le WS Jellyfin).
// `facets` est un JSON { "genre:18": poids, "kw:time-travel": … } — rien ne
// l'interroge en SQL ; un gros historique dépasse les 64 Ko.
model TasteProfile {
  id             String   @id @default(cuid())
  jellyfinUserId String   @unique
  facets         String
  signalCount    Int      @default(0)
  ratingMean     Float    @default(0)
  ratingStdDev   Float    @default(0)
  /// Part de l'univers animé dans les signaux de CONSOMMATION (0..1) — pilote
  /// la source /discover animé, le quota des rangées mixtes et la rangée
  /// « Animés pour vous ». Calculée par services/reco/profileBuilder.ts.
  animeShare     Float    @default(0)
  /// Ancres du goût : JSON des titres pondérés d'où dérive tout le classement
  /// (services/reco/anchors.ts). NULL = profil d'avant les ancres.
  anchors        String?
  /// Potentiels : JSON des titres seulement dans Ma liste — ni vus, ni aimés,
  /// ni notés — qui ne pèsent pas dans le goût (services/reco/potentials.ts).
  /// NULL = profil d'avant les potentiels (version < 5).
  potentials     String?
  schemaVersion  Int      @default(1)
  computedAt     DateTime @default(now())

  @@map("taste_profiles")
}

// Réglages de recommandation d'UN compte (page Personnalisation). Colonnes
// typées, TOUTES posées dès la première création (doctrine PlaybackSettings).
model RecoSettings {
  id                 String   @id @default(cuid())
  jellyfinUserId     String   @unique
  personalized       Boolean  @default(true)
  includeVigie       Boolean  @default(true)
  community          Boolean  @default(true)
  /// Vie privée : false = l'historique de ce compte n'alimente PAS le job de
  /// cooccurrence communautaire (désinscription, page Personnalisation).
  shareHistory       Boolean  @default(true)
  /// Curseur « Sûr ↔ Aventureux » : λ du MMR × 100 (70 = 0.7). Pilote aussi le
  /// quota d'exploration.
  explorationBalance Int      @default(70)
  /// Filtre de plateformes de la page Recommandations : JSON d'ids TMDB
  /// PRINCIPAUX (« [283,415] », douze au plus). Persisté ici pour suivre le
  /// compte d'un appareil à l'autre — et pour que le serveur précalcule la
  /// page de ce filtre en fond.
  providerFilter     String   @default("[]")
  /// « Tendances actuelles » en tête de « Pour vous » (capacité `reco.trending`,
  /// serveur 1.31.0) : allumée par défaut, coupée par le compte.
  trendingNow        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("reco_settings")
}

// Cache des rangées calculées : la page LIT ce cache ; la génération est un job
// asynchrone (services/reco/generationJob.ts), jamais dans la requête HTTP.
// Gros texte : une rangée porte des dizaines d'items avec leur ScoreBreakdown.
model RecommendationCache {
  id             String   @id @default(cuid())
  jellyfinUserId String
  rowKey         String   // "forYou" | "inLibrary" | "anime" | "discover" | "becauseYouLiked:<n>" | "community" | "exploration"
  payload        String
  generatedAt    DateTime @default(now())
  expiresAt      DateTime

  @@unique([jellyfinUserId, rowKey])
  @@index([expiresAt])
  @@map("recommendation_cache")
}

// « Ne plus me proposer » : exclusion DÉFINITIVE d'un titre des recommandations.
model RecommendationFeedback {
  id             String   @id @default(cuid())
  jellyfinUserId String
  itemKey        String   // "movie:603"
  action         String   // "dismissed" | "not_interested" | "already_seen"
  createdAt      DateTime @default(now())

  @@unique([jellyfinUserId, itemKey])
  @@map("recommendation_feedback")
}

// Mise en page de l'accueil d'UN compte. `rows` est un JSON ordonné
// [{ key, enabled }] — l'ordre EST la position dans le tableau. Aucune ligne
// stockée = accueil historique (défauts servis en 200, migration silencieuse).
model HomeLayout {
  id              String   @id @default(cuid())
  jellyfinUserId  String   @unique
  heroMode        String   @default("reco") // "resume" | "random" | "reco" | "fixed"
  heroFixedItemId String?
  rows            String
  cardDensity     String   @default("normal") // "compact" | "normal" | "large"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("home_layouts")
}

// Compte externe lié : guest session TMDB (notes anonymes).
model ExternalAccount {
  id             String    @id @default(cuid())
  jellyfinUserId String
  provider       String    // "tmdb_guest"
  guestSessionId String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  @@unique([jellyfinUserId, provider])
  @@map("external_accounts")
}

// Cooccurrence de visionnage entre paires d'items — rangée « Les utilisateurs
// de Tentacle regardent aussi ». Recalculée par un job, jamais à la volée.
// VIE PRIVÉE : une paire n'est JAMAIS exposée si userCount < 5 — sur un serveur
// familial, une paire issue d'un seul compte révèle ce que ce compte regarde.
// Le job filtre en amont ET rowBuilder refiltre en aval.
model ItemCooccurrence {
  itemAKey   String
  itemBKey   String
  score      Float
  userCount  Int
  computedAt DateTime @default(now())

  @@id([itemAKey, itemBKey])
  @@index([itemAKey])
  @@map("item_cooccurrences")
}

// Poids IDF d'une facette : log(N_total / N_facette), recalculé chaque jour sur
// bibliothèque + titres notés. Sans lui, « Drame » écraserait tout et le moteur
// recommanderait de la bouillie.
model FacetIdf {
  facetKey   String   @id
  docCount   Int
  idf        Float
  computedAt DateTime @default(now())

  @@map("facet_idf")
}

// Cache persistant des métadonnées TMDB (détails + keywords + credits en un
// appel via append_to_response). Un cache, jamais une source : vider la table
// ne coûte que des re-fetchs.
model TmdbMetaCache {
  mediaType String   // "movie" | "tv"
  tmdbId    Int
  payload   String
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@id([mediaType, tmdbId])
  @@index([expiresAt])
  @@map("tmdb_meta_cache")
}

// Personnes (acteurs, réalisateurs) aimées explicitement — matière des
// rangées « Avec {acteur} ». name/profilePath stockés : l'affichage au
// service ne dépend jamais de TMDB.
model UserLikedPerson {
  id             String   @id @default(cuid())
  jellyfinUserId String
  /// id TMDB de la personne
  personId       Int
  name           String
  profilePath    String?
  createdAt      DateTime @default(now())

  @@unique([jellyfinUserId, personId])
  @@map("user_liked_people")
}

// Jugements de l'onglet « Affiner » (swipe) — UN par titre et par compte, le
// dernier geste gagne. Ils entrent dans les ancres du goût
// (services/reco/anchors.ts) : un super like pèse plus qu'un like, un dislike
// pénalise le titre et, par similarité, ses voisins. « skip » ne juge rien :
// le titre revient dans la pile après un délai (services/swipe/swipeStore.ts).
model UserSwipe {
  id             String   @id @default(cuid())
  jellyfinUserId String
  mediaType      String   // "movie" | "tv"
  tmdbId         Int
  verdict        String   // "like" | "superlike" | "dislike" | "skip"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([jellyfinUserId, mediaType, tmdbId])
  @@index([jellyfinUserId, updatedAt])
  @@map("user_swipes")
}

// Les migrations VERSIONNÉES des extensions, passées par l'interface de
// stockage (services/pluginStorage/migrations.ts) : une ligne par extension et
// par version appliquée. L'hôte ne fait qu'y noter ; les tables de l'extension
// restent les siennes. Lue et écrite en SQL brut, des deux moteurs.
model PluginMigration {
  pluginId  String
  version   Int
  name      String
  appliedAt DateTime

  @@id([pluginId, version])
  @@map("plugin_migrations")
}

// NB : les tables de l'extension Vigie (seer_requests, seer_cleanup_queue,
// seer_user_settings, seer_tmdb_cache, seer_search_titles, seer_search_meta)
// ne sont volontairement PAS déclarées ici. Elles sont créées et migrées par
// l'extension elle-même (SQL brut, colonnes snake_case, migrations notées dans
// plugin_migrations). Le cœur ne les gère jamais : jamais de prisma db push.

// Octave — l'INDEX LOCAL de la musique Jellyfin (services : src/music/index/).
// Jellyfin reste la source de vérité : cette table n'est qu'une copie
// reconstruisible (premier passage paginé, puis évènements des sockets des
// comptes). Aucun favori, aucune playlist, aucune donnée d'un compte ici.
// La recherche passe par la table virtuelle FTS5 `music_fts` (migration 0012,
// SQL brut : Prisma ne sait pas décrire une table virtuelle).
model MusicIndexItem {
  id                String    @id // identifiant Jellyfin, sans tirets, en minuscules
  kind              String // "track" | "album" | "artist"
  name              String
  sortName          String
  albumId           String?
  albumName         String?
  albumArtist       String?
  artistsJson       String    @default("[]") // [{ id, name, mbid }] dans l'ordre du crédit
  year              Int?
  trackNumber       Int?
  discNumber        Int?
  durationMs        Int?
  recordingMbid     String?
  releaseMbid       String?
  releaseGroupMbid  String?
  artistMbid        String?
  formatJson        String? // MusicAudioFormat, tel que Jellyfin l'a lu
  sizeBytes         BigInt?
  normalizationGain Float?
  replayGainJson    String? // lu des tags à la première source demandée
  imageTag          String?
  childCount        Int?
  dateCreated       DateTime?
  syncedAt          DateTime
  generation        Int       @default(0)

  @@index([kind, sortName])
  @@index([albumId])
  @@index([recordingMbid])
  @@index([kind, dateCreated])
  @@map("music_items")
}

/// 1.40.0 (`music.listOrder`) : QUAND un titre est entré dans une liste d'Octave (Jellyfin ne date ni
/// un favori ni une entrée de playlist). `scope` = `liked:<userId>` ou `playlist:<playlistId>`.
/// Relevé à la première lecture qui le voit ; ce qui y était avant est estimé (ordre de la playlist,
/// ajout à la bibliothèque pour un like). Une ligne dont le titre a quitté la liste est effacée.
model MusicListAdded {
  scope   String
  itemId  String
  addedAt DateTime

  @@id([scope, itemId])
  @@map("music_list_added")
}

/// 1.40.0 (`music.listOrder`) : le tri d'une liste d'Octave et son ordre personnalisé, par COMPTE.
/// `listKey` = `liked` ou `playlist:<id>` ; `customJson` = `MusicCustomEntry[]` (musicListOrder.ts).
model MusicListPrefs {
  userId     String
  listKey    String
  sort       String
  direction  String
  customJson String?
  updatedAt  DateTime @updatedAt

  @@id([userId, listKey])
  @@map("music_list_prefs")
}

/// 1.40.0 : l'ORDRE DE LA SOURCE d'une playlist importée par Octave (`music/playlistSource/`). Chaque arrivée
/// (Lidarr, l'index enfin à jour) se pose juste après le titre qui la précède dans la source, et la « Date
/// d'ajout » d'un titre de la source suit son rang. `slotsJson` = `SourceSlot[]` dans l'ordre de la source (le
/// titre tel que la source le donne, et les éléments Jellyfin qui le tiennent) ; `origin` = `import` (posé à
/// l'import : ses rangs sont ceux que l'extension a reçus) ou `repair` (relu pour remettre une playlist d'avant
/// dans l'ordre). Effacée avec sa playlist.
model MusicPlaylistSource {
  playlistId String   @id
  userId     String
  source     String
  url        String?
  origin     String
  importedAt DateTime
  slotsJson  String
  updatedAt  DateTime @updatedAt

  @@map("music_playlist_sources")
}

/// 1.40.0 : le PARTAGE d'une playlist d'Octave (`music/playlistShare/`, contrat `musicShare.ts`) : un lien par
/// playlist et par compte, `token` = 16 octets au hasard en base64url. Révoquer = supprimer la ligne ; effacée
/// avec sa playlist. Le document public est relu au nom de `ownerUserId`, dans SES droits du moment.
model MusicPlaylistShare {
  token       String   @id
  playlistId  String
  ownerUserId String
  /// Le nom du compte au moment du partage (dit par la page du lien, comme Ma liste).
  ownerName   String
  createdAt   DateTime @default(now())

  @@unique([ownerUserId, playlistId])
  @@index([playlistId])
  @@map("music_playlist_shares")
}

/// 1.40.0 : les MEMBRES d'une playlist d'Octave partagée entre comptes du même serveur (`music/playlistMembers/`,
/// contrat `musicPlaylistMembers.ts`). Jellyfin ne sait pas « ajouter sans retirer » et refuse ses partages à la clé
/// d'API : Tentacle tient la liste et le droit (`read` · `add` · `remove`), et lit/écrit la playlist au nom de
/// `ownerUserId` après l'avoir vérifié. Identifiants sans tirets, en minuscules ; effacée avec sa playlist.
model MusicPlaylistMember {
  playlistId  String
  memberId    String
  ownerUserId String
  right       String
  createdAt   DateTime @default(now())

  @@id([playlistId, memberId])
  @@index([memberId])
  @@map("music_playlist_members")
}

/// 1.40.0 : un FAVORI de la bibliothèque d'Octave que Jellyfin ne peut pas tenir (`music/libraryShelves/`, contrat
/// `musicLibraryShelves.ts`) : un élément d'une extension (`ext:<extension>:<id>`, avec l'INSTANTANÉ de sa carte), ou
/// une playlist reçue d'un autre compte (`jf:<id>`, sans instantané : Jellyfin la refuse au membre). Compte sans
/// tirets, en minuscules. Les favoris de la bibliothèque restent ceux de Jellyfin (`IsFavorite`).
model MusicShelfFavorite {
  userId       String
  section      String
  itemKey      String
  snapshotJson String?
  createdAt    DateTime @default(now())

  @@id([userId, section, itemKey])
  @@map("music_shelf_favorites")
}

/// 1.41.0 : l'HISTORIQUE de la recherche d'Octave, par COMPTE (`music/searchHistory/`, contrat `musicSearchHistory.ts`) :
/// une recherche validée (`kind` = `query`, `itemKey` = la requête sans casse) ou un titre lancé depuis les résultats
/// (`kind` = `track`, `itemKey` = sa clé, `payloadJson` = son INSTANTANÉ). Compte sans tirets, en minuscules ; au plus
/// `MUSIC_SEARCH_HISTORY_MAX` lignes de chaque sorte par compte.
model MusicSearchHistory {
  userId      String
  kind        String
  itemKey     String
  payloadJson String
  at          DateTime

  @@id([userId, kind, itemKey])
  @@index([userId, kind, at])
  @@map("music_search_history")
}
