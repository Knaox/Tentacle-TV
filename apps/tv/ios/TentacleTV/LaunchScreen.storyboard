<?xml version="1.0" encoding="UTF-8"?>
<!-- L'écran de lancement EST la première image de l'app : `BootView`
     (src/redesign/screens/overlays) pose la mascotte à 200 points dans une
     lueur rose de 640, centrée 50 points au-dessus du milieu (l'indicateur
     d'attente vient dessous), sur l'encre de la scène. `LaunchLogo` est cette
     mascotte dans sa lueur (brand/tvos.py), posée au même endroit ; le fond
     est l'encre moyenne (#100D17 → #09080E). AppDelegate garde cette vue à
     l'écran jusqu'au premier rendu de React : aucun noir entre les deux. -->
<document type="com.apple.InterfaceBuilder.AppleTV.Storyboard" version="3.0" toolsVersion="15702" targetRuntime="AppleTV" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
