# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :tvos, min_ios_version_supported

# Ancienne architecture, pour s'ALIGNER sur Android (`newArchEnabled=false`
# dans android/gradle.properties). RN l'active par défaut depuis 0.76 ; on la
# désactive ici. Sinon le C++ Fabric de react-native-svg
# (RNSVGLayoutableShadowNode) ne compile pas contre le Yoga de RN
# (`StyleSizeLength` absent) — incompatibilité propre à la New Arch.
# NB : 0.81 est le DERNIER palier qui supporte encore l'ancienne architecture —
# 0.82 la supprime. Ce sera le chantier de la prochaine montée de version.
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'TentacleTV' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Lecteur local « façon Infuse » : FFmpeg LGPL (remux-only) + serveur HTTP local.
  pod 'FFmpegTVOS', :path => 'Frameworks/ffmpeg'
  pod 'GCDWebServer', '~> 3.5'

  target 'TentacleTVTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Chemin projet avec espaces ("Projet - local") : RN génère le build phase
    # codegen avec `/bin/sh -c "$WITH_ENVIRONMENT $SCRIPT_PHASES_SCRIPT"` — les
    # deux chemins (espacés) sont concaténés non quotés → /bin/sh coupe au
    # premier espace ("is a directory"). On réécrit pour SOURCER l'env puis
    # lancer le script quoté. Régénéré à chaque `pod install`, donc on patche
    # ici ; macOS-only (Windows n'exécute jamais le Podfile).
    installer.pods_project.targets.each do |target|
      target.build_phases.each do |phase|
        next unless phase.respond_to?(:shell_script) && phase.shell_script
        phase.shell_script = phase.shell_script.gsub(
          '/bin/sh -c "$WITH_ENVIRONMENT $SCRIPT_PHASES_SCRIPT"',
          '/bin/sh -c ". \"$WITH_ENVIRONMENT\"; \"$SCRIPT_PHASES_SCRIPT\""'
        )
      end
    end
    installer.pods_project.save
  end
end
