<?xml version="1.0" encoding="utf-8"?>
<!-- La PlayerView de l'aperçu au focus d'une carte (`PreviewVideoView`) : le
     cadre sans barre de contrôle (`tentacle_exo_player_frame` — sans elle,
     react-native-video gonflait un contrôleur à chaque aperçu : un blocage du
     fil UI au départ de l'aperçu suivant, et un bouton qui volait le focus),
     une TextureView (elle suit l'opacité et l'arrondi de la grande carte, la
     SurfaceView non), l'image qui REMPLIT le cadre, ni volet ni roue d'attente. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:focusable="false"
  app:player_layout_id="@layout/tentacle_exo_player_frame"
  app:surface_type="texture_view"
  app:use_controller="false"
  app:use_artwork="false"
  app:resize_mode="zoom"
  app:show_buffering="never"
  app:shutter_background_color="@android:color/transparent"/>
