__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.default=void 0;e.default={title:"Theme & Appearance",description:"Customize the look of Tentacle TV. Token overrides reach all platforms (web, desktop, mobile, TV). Custom CSS only applies to web and desktop.",adminCardTitle:"Theme",adminCardDescription:"Override brand colors and inject custom CSS",adminCardButton:"Manage theme",currentTheme:"Current theme",defaultName:"Tentacle Default",nameSectionTitle:"Theme name",nameLabel:"Name",nameSave:"Rename",nameSaved:"Theme renamed",brandSectionTitle:"Brand color",brandSectionHelp:"Used for buttons, focus rings, accents, badges. Applied across web, desktop, mobile and TV.",accentSectionTitle:"Accent color",accentSectionHelp:"Secondary color used in brand gradients (logo, hero, badges). Pairs with the brand color above to form the signature gradient.",brandColorLabel:"Color (hex)",brandColorApply:"Apply",brandColorReset:"Reset to default",brandColorReverted:"Brand color reverted to default",brandColorInvalid:"Invalid hex color (use #RRGGBB)",customCssTitle:"Custom CSS (web / desktop only)",customCssHelp:"Inject your own CSS to deeply restyle the interface. Loaded last so it overrides built-in styles. Mobile and TV apps do not use CSS \u2014 they only respect token overrides above.",customCssRiskTitle:"Security note",customCssRisk:"Custom CSS can fetch external resources via url() or @import. Only paste CSS from sources you trust.",sourceLabel:"Source",sourceInline:"Inline content",sourceUrl:"Remote URL",inlineLabel:"CSS content",inlinePlaceholder:"/* paste your custom CSS here */",urlLabel:"URL",urlPlaceholder:"https://example.com/theme.css",customCssApply:"Apply custom CSS",customCssClear:"Remove custom CSS",customCssApplied:"Custom CSS applied",customCssCleared:"Custom CSS removed",customCssCurrent:"Currently active",customCssNone:"No custom CSS applied",customCssHash:"Hash",resetAllSectionTitle:"Reset all",resetAllLabel:"Restore the default T