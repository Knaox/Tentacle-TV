__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.default=void 0;e.default={title:"About",version:"Version {{version}}",versionBuild:"Version {{version}} (build {{build}})",description:"Tentacle TV is a free media client for your own self-hosted server, designed to deliver a smooth and elegant streaming experience. Available on Web, Desktop, Mobile, and TV, it lets you browse, search, and watch your personal media library from any device.",features:"Features",featurePlayer:"Built-in video player with audio/subtitle track selection",featureResume:"Automatic playback resume",featureRequests:"Plugin system",featureDesktop:"Native desktop mode with high-performance player",featureAdaptive:"Adaptive interface: macOS, Windows, Mobile (iOS/Android), Web",featureNotifications:"Built-in notifications and support system",contact:"Contact",contactText:"For any questions or bug reports, use the built-in support system from the Help menu or contact your server administrator.",creditsLink:"Credits & Open-source licenses",copyright:"Tentacle TV {{version}} \u2014 {{year}}",creditsTitle:"Credits & Licenses",creditsIntro:"Tentacle TV is built with many open-source projects. Thanks to all the communities that make this project possible.",technologies:"Technologies",compatibleServices:"Compatible services",license:"License",licenseText:"Tentacle TV is distributed under the MIT license. Third-party libraries are subject to their respective licenses (MIT, Apache 2.0, BSD, etc.). The desktop player embeds mpv and FFmpeg; the Mac App Store build uses LGPL v2.1+ builds of them (source available at mpv.io and ffmpeg.org).",creditsDisclaimer:"This page is provided for informational purposes. Names and trademarks belong to their respective owners.",techReact:"User interface",techTypeScript:"Static typing",techVite:"Bundler & dev server",techTailwind:"Utility CSS framework",techFramerMotion:"Animations",techTanStack:"Cache & query management",techTanStackQuery:"Cac