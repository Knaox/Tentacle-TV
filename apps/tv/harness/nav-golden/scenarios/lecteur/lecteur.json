{
  "domain": "lecteur",
  "reference": "84f3cedd0",
  "defaults": {
    "settleMs": 700
  },
  "scenarios": [
    {
      "id": "lec-01",
      "title": "Entrée dans la vidéo, habillage qui s'éteint, saut → et ←, Retour quitte",
      "why": "§ 4.3 et § 5.1 de lecteur.md : focus sur lecture/pause à la première image ; habillage masqué, les flèches sautent sans rien rallumer ; Menu (couche page) quitte",
      "start": {
        "fixtures": [
          "lecteur/flux-mp4"
        ],
        "keys": [
          "wait:6",
          "down"
        ],
        "focus": "resume:0"
      },
      "steps": [
        {
          "do": "select",
          "settleMs": 4000,
          "expect": {
            "route": "Player"
          },
          "why": "le lecteur s'ouvre sur « Orgueil et Préjugés » (MP4 du banc)"
        },
        {
          "do": "wait:6",
          "expect": {
            "route": "Player"
          },
          "why": "extinction à 5 s : le fond reprend le focus"
        },
        {
          "do": "right",
          "settleMs": 400,
          "expect": {
            "route": "Player"
          },
          "why": "saut +30 s, habillage NON rallumé"
        },
        {
          "do": "left",
          "settleMs": 400,
          "expect": {
            "route": "Player"
          }
        },
        {
          "do": "menu",
          "settleMs": 1500,
          "expect": {
            "route": "Home",
            "focus": "resume:0"
          },
          "why": "habillage masqué : Retour quitte la lecture, focus rendu à la carte"
        }
      ]
    },
