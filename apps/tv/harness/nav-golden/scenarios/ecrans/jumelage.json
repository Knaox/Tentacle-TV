{
  "domain": "ecrans",
  "reference": "84f3cedd0",
  "defaults": {
    "settleMs": 1000
  },
  "scenarios": [
    {
      "id": "jumelage-accueil",
      "title": "Accueil du jumelage : entrée sur « Afficher le code » ; les deux actions côte à côte, la langue dessous ; Menu n'est pas pris (l'app quitterait) — on ne l'appuie pas",
      "why": "le code du relais (croix seule action) n'est pas joué : il interrogerait le VRAI relais de jumelage — règle JU-1 éprouvée par les tests de tv-core",
      "rules": [
        "JU-1",
        "JU-3"
      ],
      "start": {
        "session": "none",
        "fixtures": [
          "ecrans/jumelage"
        ],
        "keys": [
          "wait:5"
        ]
      },
      "steps": [
        {
          "do": "wait:1",
          "expect": {
            "focus": "pairing:showCode",
            "route": "PairCode"
          }
        },
        {
          "do": "right",
          "expect": {
            "focus": "pairing:manual"
          }
        },
        {
          "do": "down",
          "why": "la langue (relevé)"
        },
        {
          "do": "up",
          "why": "retour aux actions (relevé)"
        },
        {
          "do": "left",
          "why": "relevé"
        }
      ]
    },
    {
      "id": "jumelage-serveur-et-identifiants",
      "title": "Serveur saisi à la main puis identifiants : entrée par étape, croix atteinte par HAUT, Menu recule d'une étape à chaque fois",
      "rules": [
        "JU-1",
        "JU-2",
        "JU-5",
        "JU-6",
        "JU-7"
      ],
      "start": {
        "session": "none",
        "fixtures": [
          "ecrans/jumelage"
        ],
        "keys": [
          "wait:5"
        ]
      },
      "steps": [
        {
          "do": "wait:1",
          "expect": {
            "focus": "pairing:showCode"
          }
        },
        {
          "do": "right",
          "expect": {
            "focus": "pairing:manual"
          },
          "why": "les deux actions de l'accueil, côte à côte"
        },
        {
          "do": "select",
          "settleMs": 1500,
          "expect": {
            "focus": "pairing:url"
          }
        },
        {
          "do": "up",
          "expect": {
            "focus": "pairing:back"
          },
          "why": "la croix, libérée par le premier focus de l'étape"
        },
        {
          "do": "down",
          "expect": {
            "focus": "pairing:url"
          }
        },
        {
          "do": "select",
          "settleMs": 1500,
          "why": "OK sur le champ : le clavier système"
        },
        {
          "do": "type:http://localhost:3107\n",
          "settleMs": 4000,
          "expect": {
            "focus": "pairing:username"
          },
          "why": "serveur vérifié : les identifiants, entrée sur l'identifiant"
        },
        {
          "do": "up",
          "expect": {
            "focus": "pairing:back"
          }
        },
        {
          "do": "down",
          "expect": {
            "focus": "pairing:username"
          }
        },
        {
          "do": "down",
          "expect": {
            "focus": "pairing:password"
          }
        },
        {
          "do": "down",
          "expect": {
            "focus": "pairing:signIn"
          },
          "why": "le groupe pairing:actions entre par « Se connecter »"
        },
        {
          "do": "right",
          "expect": {
            "focus": "pairing:useCode"
          }
        },
        {
          "do": "menu",
          "settleMs": 1500,
          "expect": {
            "focus": "pairing:url"
          },
          "why": "identifiants → serveur"
        },
        {
          "do": "menu",
          "settleMs": 1500,
          "expect": {
            "focus": "pairing:showCode"
          },
          "why": "serveur → accueil ; un Menu de plus quitterait l'application"
        }
      ]
    },
    {
      "id": "jumelage-connexion-refusee",
      "title": "Connexion refusée : le mot de passe vidé reprend le focus ; « Se connecter » sans identifiant ouvre son clavier",
      "rules": [
        "JU-1",
        "JU-4",
        "JU-5",
        "JU-6"
      ],
      "start": {
        "session": "none",
        "fixtures": [
          "ecrans/jumelage"
        ],
        "keys": [
          "wait:5"
        ]
      },
      "steps": [
        {
          "do": "wait:1",
          "expect": {
            "focus": "pairing:showCode"
          }
        },
        {
          "do": "right",
          "expect": {
            "focus": "pairing:manual"
          },
          "why": "les deux actions de l'accueil, côte à côte"
        },
        {
          "do": "select",
          "settleMs": 1500,
          "expect": {
            "focus": "pairing:url"
          }
        },
        {
          "do": "select",
          "settleMs": 1500
        },
        {
          "do": "type:http://localhost:3107\n",
          "settleMs": 4000,
          "expect": {
            "focus": "pairing:username"
          }
        },
        {
          "do": "select",
          "settleMs": 1500,
          "why": "le clavier de l'identifiant"
        },
        {
          "do": "type:banc\n",
          "settleMs": 2000,
          "expect": {
            "writes": []
          },
          "why": "mot de passe vide : valider n'envoie rien, le clavier se ferme"
        },
        {
          "do": "down",
          "expect": {
            "focus": "pairing:password"
          }
        },
        {
          "do": "select",
          "settleMs": 1500
        },
        {
          "do": "type:faux\n",
          "settleMs": 4000,
          "expect": {
            "focus": "pairing:password"
          },
          "why": "les deux champs remplis : envoyé, refusé (401) ; le mot de passe vidé reprend le focus"
        },
        {
          "do": "down",
          "expect": {
            "focus": "pairing:signIn"
          }
        },
        {
          "do": "select",
          "settleMs": 1500,
          "why": "mot de passe vide : « Se connecter » ouvre SON clavier, rien n'est envoyé"
        },
        {
          "do": "menu",
          "settleMs": 1500,
          "why": "Menu ferme le clavier (relevé du focus rendu par tvOS)"
        }
      ]
    }
  ]
}
