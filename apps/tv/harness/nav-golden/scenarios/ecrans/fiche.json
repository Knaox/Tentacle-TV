    {
      "id": "fiche-croix",
      "title": "Film : entrée sur Lecture, jamais sur la croix ; HAUT y mène depuis l'en-tête, BAS rend la dernière action ; Menu recule",
      "rules": [
        "FI-1",
        "FI-2",
        "FI-3",
        "FI-13"
      ],
      "start": {
        "fixtures": [
          "base/vigie-off"
        ],
        "route": {
          "name": "MediaDetail",
          "params": {
            "itemId": "8691fdd93af7c11da75013ecc6a67ac0"
          }
        },
        "keys": [
          "wait:5"
        ]
      },
      "steps": [
        {
          "do": "wait:1",
          "expect": {
            "focus": "detail:primary",
            "route": "MediaDetail"
          },
          "why": "la croix, en haut à gauche, n'a jamais l'entrée"
        },
        {
          "do": "up",
          "expect": {
            "focus": "detail:back",
            "label": "Retour"
          },
          "why": "la bande detail:top rend HAUT à la croix",
          "settleMs": 1500
        },
        {
          "do": "down",
          "expect": {
            "focus": "detail:primary"
          },
          "why": "BAS depuis la croix : la dernière cible de contenu",
          "settleMs": 1500
        },
        {
          "do": "right"
        },
        {
          "do": "up",
          "expect": {
            "focus": "detail:back"
          },
          "settleMs": 1500
        },
        {
          "do": "down",
          "why": "la dernière action visitée, pas l'entrée (relevé)",
          "settleMs": 1500
        },
        {
          "do": "menu",
          "settleMs": 1200,
          "expect": {
            "route": "Home"
          }
        }
      ]
    },
