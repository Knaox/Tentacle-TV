      "title": "Film : entrée sur Lecture, jamais sur la croix ; HAUT y mène depuis l'en-tête, BAS rend la dernière action ; Menu recule",
      "rules": ["FI-1", "FI-2", "FI-3", "FI-13"],
      "start": {
        "session": "paired",
        "fixtures": ["base"],
        "stack": [{ "name": "Home" }, { "name": "MediaDetail", "params": { "itemId": "8691fdd93af7c11da75013ecc6a67ac0" } }]
      },
      "steps": [
        { "do": "wait:2.5", "expect": { "focus": "detail:primary", "route": "MediaDetail" }, "why": "la croix, en haut à gauche, n'a jamais l'entrée" },
        { "do": "up", "expect": { "focus": "detail:back", "label": "Retour" }, "why": "la bande detail:top rend HAUT à la croix" },
        { "do": "down", "expect": { "focus": "detail:primary" }, "why": "BAS depuis la croix : la dernière cible de contenu" },
        { "do": "right" },
        { "do": "up", "expect": { "focus": "detail:back" } },
        { "do": "down", "why": "la dernière action visitée (relevée), pas l'entrée" },
        { "do": "menu", "settleMs": 1000, "expect": { "route": "Home", "stack": ["Home"] } }
      ]
    },
