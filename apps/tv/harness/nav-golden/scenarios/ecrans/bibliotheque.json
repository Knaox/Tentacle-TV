{
  "domain": "ecrans",
  "reference": "84f3cedd0",
  "defaults": {
    "settleMs": 1000
  },
  "scenarios": [
    {
      "id": "bibliotheque-entree-et-bords",
      "title": "Films en rangées : entrée sur la première carte de la première rangée ; HAUT vers la barre ; le bout d'une rangée ne mène nulle part",
      "rules": [
        "BI-1",
        "BI-2",
        "BI-3",
        "GR-1",
        "GR-3"
      ],
      "start": {
        "fixtures": [
          "base/vigie-off"
        ],
        "route": {
          "name": "Library",
          "params": {
            "libraryId": "db4c1708cbb5dd1676284a40f2950aba",
            "libraryName": "Films"
          }
        },
        "keys": [
          "wait:6"
        ]
      },
      "steps": [
        {
          "do": "wait:1",
          "expect": {
            "focus": "group:genre:6a24d9a479675b918371054b545b59a0:0",
            "route": "Library"
          }
        },
        {
          "do": "up",
          "expect": {
            "focus": "pill:group"
          },
          "why": "la barre de filtres, par sa pastille de tête « Ranger par »"
        },
        {
          "do": "down",
          "expect": {
            "focus": "group:genre:6a24d9a479675b918371054b545b59a0:0"
          },
          "why": "la première rangée, par sa carte au retrait"
        },
        {
          "do": [
            "right",
            "wait:0.4",
            "right",
            "wait:0.4",
            "right",
            "wait:0.4",
            "right"
          ],
          "settleMs": 800,
          "expect": {
            "focus": "group:genre:6a24d9a479675b918371054b545b59a0:4"
          }
        },
        {
          "do": "down",
          "expect": {
            "focus": "group:genre:ce06903d834d2c3417e0889dd4049f3b:0"
          },
          "why": "la rangée suivante, par sa carte au retrait"
        },
        {
          "do": "up",
          "expect": {
            "focus": "group:genre:6a24d9a479675b918371054b545b59a0:4"
          },
          "why": "la rangée garde sa carte au retrait"
        },
        {
          "do": [
            "right",
            "wait:0.35",
            "right",
            "wait:0.35",
            "right",
            "wait:0.35",
            "right",
            "wait:0.35",
            "right",
            "wait:0.35",
            "right",
            "wait:0.35",
            "right",
            "wait:0.35",
            "right",
            "wait:0.35",
            "right",
            "wait:0.35",
            "right",
            "wait:0.35",
            "right",
            "wait:0.35",
            "right",
            "wait:0.35",
            "right"
          ],
          "settleMs": 800,
          "expect": {
            "focus": "group:genre:6a24d9a479675b918371054b545b59a0:17"
          },
          "why": "la dernière carte de « Drame » (18 titres)"
        },
        {
          "do": "right",
          "settleMs": 600,
          "expect": {
            "focus": "group:genre:6a24d9a479675b918371054b545b59a0:17"
          },
          "why": "le bout d'une rangée : rien à atteindre"
        },
        {
          "do": "menu",
          "settleMs": 1200,
          "expect": {
            "focus": "group:genre:6a24d9a479675b918371054b545b59a0:0"
          },
          "why": "Retour : la rangée revient au début, le focus sur sa première carte"
        },
        {
          "do": "left",
          "expect": {
            "focus": "nav:Library_db4c1708cbb5dd1676284a40f2950aba"
          },
          "why": "au-delà du bord gauche : l'entrée active du rail (T4)"
        },
        {
          "do": "right",
          "expect": {
            "focus": "group:genre:6a24d9a479675b918371054b545b59a0:0"
          }
        }
      ],
      "why": "La carte qui s'ouvre (19/10) : la bibliothèque est rangée par genre (« Ranger par »), la carte focalisée toujours au retrait de sa rangée, et l'on entre dans une rangée par cette carte."
    },
    {
      "id": "bibliotheque-defilement",
      "title": "1 200 films en rangées : flèche maintenue jusqu'au fond puis jusqu'en haut — la première rangée ramène la page en haut",
      "rules": [
        "GR-2",
        "GR-4"
      ],
      "start": {
        "fixtures": [
          "base/vigie-off",
          "ecrans/grande-bibliotheque"
        ],
        "route": {
          "name": "Library",
          "params": {
            "libraryId": "db4c1708cbb5dd1676284a40f2950aba",
            "libraryName": "Films"
          }
        },
        "keys": [
          "wait:8"
        ]
      },
      "steps": [
        {
          "do": "wait:1"
        },
        {
          "do": [
            "holddown:8",
            "holdup:10"
          ],
          "settleMs": 2000,
          "why": "jusqu'à la dernière rangée puis jusqu'à la première : chaque rangée se charge à l'approche, en affiches fantômes à sa hauteur ; relevé à la fin seulement"
        },
        {
          "do": "up",
          "expect": {
            "focus": "pill:group"
          },
          "why": "la première rangée a ramené la page tout en haut : la barre de filtres est là"
        }
      ]
    },
    {
      "id": "bibliotheque-liste-genres",
      "title": "Liste des genres : entrée sur le premier choix, cocher sans bouger, BAS vers « Voir N titres », Menu ferme et rend la pastille",
      "rules": [
        "BI-5",
        "BI-6",
        "BI-7",
        "BI-8",
        "BI-10",
        "BI-12"
      ],
      "start": {
        "fixtures": [
          "base/vigie-off"
        ],
        "route": {
          "name": "Library",
          "params": {
            "libraryId": "db4c1708cbb5dd1676284a40f2950aba",
            "libraryName": "Films"
          }
        },
        "keys": [
          "wait:6"
        ]
      },
      "steps": [
        {
          "do": "wait:1",
          "expect": {
            "focus": "group:genre:6a24d9a479675b918371054b545b59a0:0"
          }
        },
        {
          "do": "up",
          "expect": {
            "focus": "pill:group"
          }
        },
        {
          "do": [
            "right",
            "wait:0.3",
            "right",
            "wait:0.3",
            "right"
          ],
          "expect": {
            "focus": "pill:genres"
          },
          "why": "« Ranger par », Visionnage, Favoris, puis Genres"
        },
        {
          "do": "select",
          "settleMs": 1200,
          "expect": {
            "focus": "sheet:option:0",
            "panel": "open"
          },
          "why": "rien de retenu : le premier choix"
        },
        {
          "do": [
            "down",
            "down"
          ],
          "why": "relevé : les options sont en colonnes, BAS saute une rangée"
        },
        {
          "do": "select",
          "expect": {
            "panel": "open"
          },
          "why": "cocher ne déplace pas le focus"
        },
        {
          "do": "holddown:4",
          "settleMs": 800,
          "expect": {
            "focus": "sheet:apply"
          },
          "why": "le pied, par « Voir N titres »"
        },
        {
          "do": "menu",
          "settleMs": 1500,
          "expect": {
            "focus": "pill:genres",
            "panel": "closed"
          }
        },
        {
          "do": "down",
          "why": "la rangée des filtres actifs (relevé : le filtre ou « Tout effacer », au plus proche)"
        },
        {
          "do": "right",
          "expect": {
            "focus": "active:clear"
          },
          "why": "« Tout effacer », au bout de la rangée"
        },
        {
          "do": "select",
          "settleMs": 1200,
          "expect": {
            "focus": "pill:group"
          },
          "why": "« Tout effacer » rend la pastille de tête"
        }
      ]
    },
    {
