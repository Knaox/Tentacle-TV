{
  "domain": "ecrans",
  "reference": "3ed2ec95e",
  "defaults": {
    "settleMs": 1000
  },
  "scenarios": [
    {
      "id": "collections-ma-liste",
      "title": "Ma liste en rangées : entrée sur la première carte ; OK ouvre la fiche, Menu y revient sur la carte",
      "rules": [
        "CO-1",
        "GR-5",
        "FI-2"
      ],
      "start": {
        "fixtures": [
          "base/vigie-off"
        ],
        "route": {
          "name": "Watchlist"
        },
        "keys": [
          "wait:6"
        ]
      },
      "steps": [
        {
          "do": "wait:1",
          "expect": {
            "focus": "group:type:anime:0",
            "route": "Watchlist"
          }
        },
        {
          "do": "select",
          "settleMs": 2500,
          "expect": {
            "route": "MediaDetail"
          }
        },
        {
          "do": "menu",
          "settleMs": 2000,
          "expect": {
            "focus": "group:type:anime:0",
            "route": "Watchlist"
          }
        },
        {
          "do": "left",
          "expect": {
            "focus": "nav:Watchlist"
          },
          "why": "l'entrée active du rail (T4)"
        }
      ]
    },
    {
      "id": "collections-favoris-vides",
      "title": "Favoris vides : entrée sur « Parcourir les bibliothèques », qui mène à l'accueil",
      "rules": [
        "CO-1",
        "CO-2"
      ],
      "start": {
        "fixtures": [
          "base/vigie-off",
          "ecrans/favoris-vides"
        ],
        "route": {
          "name": "Favorites"
        },
        "keys": [
          "wait:6"
        ]
      },
      "steps": [
        {
          "do": "wait:1",
          "expect": {
            "focus": "empty:primary",
            "route": "Favorites"
          }
        },
        {
          "do": "select",
          "settleMs": 2500,
          "expect": {
            "route": "Home"
          }
        }
      ]
    }
  ]
}
