      "start": {
        "fixtures": [
          "base/vigie-off"
        ],
        "route": {
          "name": "Library",
          "params": {
            "libraryId": "db4c1708cbb5dd1676284a40f2950aba",
            "libraryName": "Films"
          }
        },
        "keys": [
          "wait:3"
        ],
        "focus": "grid:0"
      },
      "steps": [
        {
          "do": [
            "left",
            "up"
          ],
          "expect": {
            "focus": "nav:Library_acf898949f3c87c958b3784cb05fd4d1",
            "label": "Animés"
          },
          "why": "GAUCHE : l'entrée de la page (Films) ; HAUT : Animés"
        },
        {
          "do": "hold:1.5",
          "settleMs": 1000,
          "expect": {
            "panel": "open",
            "focus": "nav:menu:move",
            "label": "Déplacer"
          },
          "why": "O1.2 : tvOS focalise la ligne du haut ; le relâchement n'agit pas (garde anti-clic fantôme)"
        },
        {
          "do": "down",
          "expect": {
            "focus": "nav:menu:up",
            "label": "Monter"
          }
        },
        {
          "do": "down",
          "expect": {
            "focus": "nav:menu:down",
            "label": "Descendre"
          }
        },
        {
          "do": "down",
          "expect": {
            "focus": "nav:menu:hide",
            "label": "Masquer"
          }
        },
        {
          "do": "down",
          "expect": {
            "focus": "nav:menu:settings",
            "label": "Réglages de la navigation"
