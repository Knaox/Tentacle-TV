{
  "domain": "focus",
  "reference": "aec99c332",
  "defaults": {
    "settleMs": 900
  },
  "scenarios": [
    {
      "id": "home-entry",
      "title": "Entrée de l'accueil sur la bannière ; le rail ouvert puis refermé rend le focus au contenu",
      "why": "A1-A4, A6 : l'arrivée pose la préférence sur l'entrée et se clôt au premier focus de contenu ; contentKey() est ce que vise le pont du rail. Seul scénario SANS approche : son relevé de départ EST l'entrée. Sous forte charge, la référence la perd aussi (constat 4 de focus.md : le rail focalisé plus de 600 ms après le premier rendu clôt l'arrivée) — un départ relevé sur nav:Home est cette course, pas une régression",
      "rules": [
        "A1",
        "A2",
        "A3",
        "A4",
        "A6",
        "H7",
        "W3"
      ],
      "start": {
        "fixtures": [
          "focus/home"
        ],
        "route": {
          "name": "Home"
        },
        "focus": "hero:primary"
      },
      "steps": [
        {
          "do": "left",
          "expect": {
            "focus": "nav:Home"
          },
          "why": "le pont du rail (T4) mène à l'entrée active"
        },
        {
          "do": "right",
          "expect": {
            "focus": "hero:primary"
          },
          "why": "A4 : la dernière clé de contenu encore montée"
        },
        {
          "do": "right",
          "settleMs": 500,
          "expect": {
            "focus": "hero:primary"
          },
          "why": "la bannière tourne : le titre suivant, le focus reste"
        },
        {
          "do": "left",
          "settleMs": 500,
          "expect": {
            "focus": "hero:primary"
          },
          "why": "GAUCHE : le titre précédent"
        },
        {
          "do": "left",
          "expect": {
            "focus": "nav:Home"
          }
        },
        {
          "do": "right",
          "expect": {
            "focus": "hero:primary"
          }
        }
      ]
    },
    {
      "id": "home-rows",
      "title": "BAS / HAUT de rangée en rangée, par la carte posée au retrait",
      "why": "Carte qui s'ouvre (19/10) : la carte focalisée est toujours au retrait de sa rangée, et l'on entre dans une rangée par cette carte (tv-core openRowEntry), jamais par celle d'en face ; une rangée quittée garde la sienne. La pastille du filtre (en-tête de « Pour vous ») n'est atteinte que par HAUT depuis la première carte. Mise en page du banc : bannière, Reprendre, À suivre, « Pour vous », Derniers ajouts (Films), Déjà vus, Ma liste.",
      "rules": [
        "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        "R6",
        "V1",
        "V2",
        "V4",
        "V5",
        "V6",
        "W1",
        "W2",
        "H7"
      ],
      "start": {
        "fixtures": [
          "focus/home"
        ],
        "route": {
          "name": "Home"
        },
        "keys": [
          "wait:1",
          "left",
          "right"
        ],
        "focus": "hero:primary"
      },
      "steps": [
        {
          "do": "down",
          "expect": {
            "focus": "resume:0"
          },
          "why": "la carte au retrait de Reprendre"
        },
        {
          "do": "down",
          "expect": {
            "focus": "nextUp:0"
          }
        },
        {
          "do": "down",
          "expect": {
            "focus": "reco:forYou:0"
          },
          "why": "la pastille de l'en-tête n'est pas un arrêt en descendant"
        },
        {
          "do": "down",
          "expect": {
            "focus": "library:db4c1708cbb5dd1676284a40f2950aba:0"
          }
        },
        {
          "do": "down",
          "expect": {
            "focus": "watched:0"
          }
        },
        {
          "do": "up",
          "expect": {
            "focus": "library:db4c1708cbb5dd1676284a40f2950aba:0"
          },
          "why": "la carte que la rangée garde au retrait"
        },
        {
          "do": "up",
          "expect": {
            "focus": "reco:forYou:0"
          }
        },
        {
          "do": "up",
          "expect": {
            "focus": "filter:remove"
          },
          "why": "HAUT depuis la première carte : la pastille, tête de la section"
        },
        {
          "do": "up",
          "expect": {
            "focus": "nextUp:0"
          }
        },
        {
          "do": "up",
          "expect": {
            "focus": "resume:0"
          }
        },
        {
          "do": "up",
          "expect": {
            "focus": "hero:primary"
          },
          "why": "la bannière, page tout en haut"
        },
        {
          "do": [
            "right",
            "wait:0.4",
            "right"
          ],
          "settleMs": 500,
          "expect": {
            "focus": "hero:primary"
          },
          "why": "la bannière tourne"
        },
        {
          "do": "down",
          "expect": {
            "focus": "resume:0"
          },
          "why": "BAS depuis la bannière : la carte au retrait, jamais celle d'en face"
        },
        {
          "do": [
            "right",
            "wait:0.4",
            "right"
          ],
          "settleMs": 600,
          "expect": {
            "focus": "resume:2"
          },
          "why": "deux cartes plus loin, ouverte au retrait"
        },
        {
          "do": "down",
          "expect": {
            "focus": "nextUp:0"
          },
          "why": "la rangée suivante, par SA carte au retrait"
        },
        {
          "do": [
            "right",
            "wait:0.4",
            "right"
          ],
          "settleMs": 600,
          "expect": {
            "focus": "nextUp:2"
          }
        },
        {
          "do": "down",
          "expect": {
            "focus": "reco:forYou:0"
          }
        },
        {
          "do": "down",
          "expect": {
            "focus": "library:db4c1708cbb5dd1676284a40f2950aba:0"
          }
        },
        {
          "do": "up",
          "expect": {
            "focus": "reco:forYou:0"
          }
        },
        {
          "do": "up",
          "expect": {
            "focus": "filter:remove"
          },
          "why": "la première carte : la pastille, à l'aplomb dans la section"
        },
        {
          "do": "up",
          "expect": {
            "focus": "nextUp:0"
          },
          "why": "À suivre est sortie de l'écran (deux rangées plus bas) : revenue au début (tv-core rowRewind)"
        },
        {
          "do": "up",
          "expect": {
            "focus": "resume:0"
          },
          "why": "Reprendre aussi"
        }
      ]
    },
