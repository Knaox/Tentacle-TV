          "settleMs": 500,
          "expect": {
            "focus": "hero:primary"
          }
        },
        {
          "do": "left",
          "expect": {
            "focus": "nav:Home"
          }
        },
        {
          "do": [
            "down",
            "wait:0.6",
            "select"
          ],
          "settleMs": 2000,
          "expect": {
            "route": "Recommendations"
          }
        },
        {
          "do": "left",
          "expect": {
            "focus": "nav:Recommendations"
          }
        },
        {
          "do": [
            "up",
            "wait:0.6",
            "select"
          ],
          "settleMs": 1500,
          "expect": {
            "route": "Home",
            "focus": "hero:primary"
          },
          "why": "A4 : la dernière clé de contenu de l'accueil"
        },
        {
          "do": "down",
          "why": "W6 : Reprendre est revenue au début"
        }
      ]
    },
    {
      "id": "rangee-retour-de-fiche",
      "title": "Revenir d'une fiche rend la rangée exactement comme on l'a laissée",
      "why": "W6 : une fiche n'est pas un changement de page — Retour rend le focus à l'affiche ouverte, la rangée à sa place.",
