          "settleMs": 700,
          "expect": {
            "focus": "resume:4"
          }
        },
        {
          "do": "up",
          "expect": {
            "focus": "hero:list"
          },
          "why": "le héros, au plus proche ; Reprendre reste défilée, à l'écran"
        },
        {
          "do": [
            "left",
            "wait:0.4",
            "left"
