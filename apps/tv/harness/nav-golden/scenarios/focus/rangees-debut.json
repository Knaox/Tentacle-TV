{
  "domain": "focus",
  "reference": "aec99c332",
  "defaults": {
    "settleMs": 900
  },
  "scenarios": [
    {
      "id": "rangee-a-l-ecran",
      "title": "Une rangée défilée garde sa place tant qu'elle est à l'écran",
      "why": "W6 (mode mixte, 2026-10-04) : descendre d'un cran pour regarder la rangée suivante ne fait rien perdre — HAUT ramène sur Reprendre, toujours défilée (au plus proche, loin de la première carte).",
      "rules": [
        "W6",
        "R6"
      ],
      "start": {
        "fixtures": [
          "focus/home"
        ],
        "route": {
          "name": "Home"
        },
        "keys": [
          "wait:1",
          "left",
          "right"
        ],
        "focus": "hero:primary"
      },
      "steps": [
        {
          "do": "down",
          "expect": {
            "focus": "resume:0"
          }
        },
        {
          "do": [
            "right",
            "wait:0.4",
            "right",
            "wait:0.4",
            "right",
            "wait:0.4",
            "right"
          ],
          "settleMs": 700,
          "expect": {
            "focus": "resume:4"
          }
        },
        {
          "do": "down",
          "why": "À suivre, au plus proche de la 5e vignette : Reprendre reste à l'écran"
        },
        {
          "do": "up",
          "why": "W6 : Reprendre n'a pas bougé — la vignette au plus proche, pas la première"
        }
      ]
    },
    {
      "id": "rangee-sortie",
      "title": "Sortie de l'écran, la rangée revient au début ; celle encore à l'écran garde sa place",
      "why": "W6 : quatre rangées plus bas, Reprendre n'est plus à l'écran — elle revient au début sans animation ; en remontant, HAUT y entre au plus proche, donc au début.",
      "rules": [
        "W6",
        "R6",
        "V2"
      ],
      "start": {
        "fixtures": [
          "focus/home"
        ],
        "route": {
          "name": "Home"
