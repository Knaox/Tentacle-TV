          "settleMs": 700,
          "expect": {
            "focus": "resume:4"
          }
        },
        {
          "do": "down"
        },
        {
          "do": "down"
        },
        {
          "do": "down"
        },
        {
          "do": "down",
          "why": "Films : Reprendre est sortie de l'écran par le haut"
        },
        {
          "do": "up"
        },
        {
          "do": "up"
        },
        {
          "do": "up"
        },
        {
          "do": "up",
          "why": "W6 : Reprendre est revenue au début — la vignette au plus proche est l'une des premières"
        }
      ]
    },
    {
      "id": "rangee-changement-de-page",
      "title": "Changer de page par le rail remet les rangées au début ; le focus revient où il était",
      "why": "W6 : Accueil → « Pour vous » → Accueil, par le rail. Reprendre était défilée et à l'écran (le focus sur le héros) : au retour, elle est au début.",
      "rules": [
        "W6",
        "A4",
        "N1.2"
      ],
      "start": {
        "fixtures": [
          "focus/home"
        ],
        "route": {
          "name": "Home"
        },
        "keys": [
          "wait:1",
          "left",
          "right"
        ],
        "focus": "hero:primary"
