{
  "domain": "focus",
  "reference": "84f3cedd0",
  "defaults": {
    "settleMs": 600
  },
  "scenarios": [
    {
      "id": "hero-beyond-edge",
      "title": "La bannière, UNE cible : DROITE et GAUCHE tournent ses titres, le focus ne la quitte pas ; GAUCHE sur le premier titre mène au rail",
      "why": "Carte qui s'ouvre (19/10) — X2 : le geste qui AMÈNE le focus sur la bannière ne compte pas (moins de 400 ms) ; H3 : un geste, un titre, en boucle sur les 5 titres ; GAUCHE retenu tant qu'il y a un titre avant, puis le rail (tv-core hero/heroNav.ts). Elle ne tourne jamais sous le focus : le titre affiché est déterministe.",
      "rules": [
        "X1",
        "X2",
        "X3",
        "X4",
        "H3",
        "H4",
        "H7",
        "R11"
      ],
      "start": {
        "fixtures": [
          "focus/home"
        ],
        "route": {
          "name": "Home"
        },
        "keys": [
          "wait:1",
          "left",
          "right"
        ],
        "focus": "hero:primary"
      },
      "steps": [
        {
          "do": [
            "wait:0.6",
            "right"
          ],
          "settleMs": 500,
          "expect": {
            "focus": "hero:primary"
          },
          "why": "H3 : le titre suivant, le focus reste"
        },
        {
          "do": "left",
          "settleMs": 500,
          "expect": {
            "focus": "hero:primary"
          },
          "why": "GAUCHE : le titre précédent — retenu, il y en a un avant"
        },
        {
          "do": "left",
          "expect": {
            "focus": "nav:Home"
          },
          "why": "sur le premier titre, GAUCHE mène au rail, comme depuis la première carte d'une rangée"
        },
        {
          "do": "right",
          "expect": {
            "focus": "hero:primary"
          },
          "why": "X2 : le geste qui ramène sur la bannière ne tourne rien"
        },
        {
          "do": [
            "wait:0.6",
            "right",
            "wait:0.5",
            "right",
            "wait:0.5",
            "right",
            "wait:0.5",
            "right"
          ],
          "settleMs": 500,
          "expect": {
            "focus": "hero:primary"
          },
          "why": "le cinquième titre"
        },
        {
          "do": "right",
          "settleMs": 500,
          "expect": {
            "focus": "hero:primary"
          },
          "why": "en boucle : le premier"
        },
        {
          "do": "down",
          "expect": {
            "focus": "resume:0"
          },
          "why": "BAS : la rangée, par sa carte au retrait"
        },
        {
          "do": "up",
          "expect": {
            "focus": "hero:primary"
          }
        }
      ]
    },
    {
      "id": "hero-rotation",
      "title": "La bannière ne tourne jamais sous le focus ; visible sans focus, elle tourne toutes les 8 s ; le grand panneau",
      "why": "H2 : 8 s, seulement visible et SANS focus (tv-core heroRotationActive) ; H5 : OK maintenu ouvre le grand panneau du titre affiché.",
      "rules": [
        "H2",
        "H4",
        "H5"
      ],
      "start": {
        "fixtures": [
          "focus/home"
        ],
        "route": {
          "name": "Home"
        },
        "keys": [
          "wait:1",
          "left",
          "right"
        ],
        "focus": "hero:primary"
      },
      "steps": [
        {
          "do": "wait:1",
          "settleMs": 0,
          "expect": {
            "focus": "hero:primary"
          }
        },
        {
          "do": "wait:9",
          "settleMs": 0,
          "expect": {
            "focus": "hero:primary"
          },
          "why": "sous le focus : le même titre"
        },
        {
          "do": "left",
          "expect": {
            "focus": "nav:Home"
          },
          "why": "le rail ; la bannière reste visible"
        },
        {
          "do": "wait:9",
          "settleMs": 0,
          "expect": {
            "focus": "nav:Home"
          },
          "why": "visible sans focus : un titre de plus"
        },
        {
          "do": "right",
          "expect": {
            "focus": "hero:primary"
          }
        },
        {
          "do": "hold:1.2",
          "settleMs": 1000,
          "expect": {
            "panel": "open"
          },
          "why": "H5 : le grand panneau du titre affiché"
        },
        {
          "do": "wait:10",
          "settleMs": 0,
          "expect": {
            "panel": "open"
          },
          "why": "panneau ouvert : rien ne tourne"
        },
        {
          "do": "menu",
          "settleMs": 1500,
          "expect": {
            "focus": "hero:primary",
            "panel": "closed"
          }
        }
      ]
    }
  ]
}
