{
  "domain": "panneaux-cartes",
  "task": "T6",
  "reference": "84f3cedd0",
  "doc": "docs/tv-navigation/panneaux-cartes.md",
  "format": {
    "status": "provisoire : données pures, en attendant le format du banc nav-golden (T2), qui les reprendra telles quelles ou par conversion",
    "do": "gestes de l'agent apps/tv/harness/atv-remote : up, down, left, right, select, menu, play, hold:<s> (OK tenu), wait:<s>",
    "expect.focus": "clé du port de focus (redesign/focus/focusBinding) qui porte le focus natif après le geste",
    "expect.label": "libellé d'accessibilité attendu (français), pour un banc qui lit l'élément focalisé par XCUITest",
    "expect.panel": "open | closed — le grand panneau (ou la feuille) présenté dans sa Modal",
    "expect.writes": "écritures vues par le faux backend depuis le geste précédent ; [] = aucune",
    "expect.hint": "« Maintenir OK : plus d'options » visible sous la carte focalisée",
    "settleMs": "attente avant de lire l'attendu (fondus, entrée décidée)"
  },
  "fixtures": {
    "home.watchlist": "rangée Ma liste de l'accueil (affiches) : [0] film notable SANS note ; [1] film notable noté 7/10 ; [2] film SANS note possible (aucune cible de note)",
    "home.resume": "rangée Reprendre (vignettes 16:9) : [0] épisode entamé, notable, sans note",
    "home.hero": "héros de l'accueil présent, issu de Reprendre",
    "forYou": "Pour vous : un filtre de plateformes ACTIF ; étagère [0] carte [0] reco EN bibliothèque, notable",
    "detail.movie": "fiche d'un film notable sans note (bouton detail:rate présent) ; une saga dont un volet est ABSENT (garde Vigie ouverte ET fermée)",
    "detail.series": "fiche d'une série : saison affichée avec au moins deux épisodes",
    "library": "grille d'une bibliothèque de films",
    "search.absent": "recherche dont la rangée « À demander » contient [0] un film absent que Vigie offre de demander, [1] une série absente à 3 saisons demandables",
    "vigie": "Vigie factice (modes on / off), aucune demande relayée : chaque POST journalisé",
    "offline": "santé du serveur commutable (/api/health coupé)",
    "never": "aucune note réelle : les écritures de note ne se font QUE sur le faux backend"
  },
  "scenarios": [
    {
      "id": "pc-01",
      "title": "Appui maintenu sur une affiche sans note : entrée à 5, guides, Retour",
      "rules": ["3.1", "3.2", "3.3", "3.4", "3.5", "3.6", "3.8"],
      "start": { "screen": "Home", "focus": "watchlist:0", "data": "home.watchlist[0]" },
      "steps": [
        { "do": "wait:0.6", "expect": { "focus": "watchlist:0", "hint": true, "panel": "closed" } },
        { "do": "hold:1.2", "settleMs": 900, "expect": { "panel": "open", "focus": "sheet:scale:5", "label": "Noter 5 sur 10", "writes": [] }, "why": "entrée à 5/10 ; le relâchement de l'appui maintenu ne note rien (garde anti-clic fantôme)" },
        { "do": "right", "expect": { "focus": "sheet:scale:6" } },
        { "do": "left", "expect": { "focus": "sheet:scale:5" } },
        { "do": "left", "expect": { "focus": "sheet:scale:4" } },
        { "do": "up", "expect": { "focus": "sheet:close", "label": "Retour" } },
        { "do": "down", "expect": { "focus": "sheet:scale:5" }, "why": "le cran RETENU (aucune note : 5), jamais le cran quitté" },
        { "do": "down", "expect": { "focus": "sheet:action:play" }, "why": "première visite des pictos : la lecture" },
        { "do": "right", "expect": { "focus": "sheet:action:watchlist" } },
        { "do": "up", "expect": { "focus": "sheet:scale:5" } },
        { "do": "down", "expect": { "focus": "sheet:action:watchlist" }, "why": "le dernier picto visité" },
        { "do": "menu", "settleMs": 900, "expect": { "panel": "closed", "focus": "watchlist:0", "writes": [] } }
      ]
