        "focus": "library:db4c1708cbb5dd1676284a40f2950aba:0"
      },
      "steps": [
        {
          "do": "wait:0.6",
          "expect": {
            "focus": "library:db4c1708cbb5dd1676284a40f2950aba:0",
            "text": "Maintenir OK : plus d'options",
            "panel": "closed"
          },
          "why": "l'indication de l'appui maintenu sous la carte focalisée"
        },
        {
          "do": "hold:1.2",
          "settleMs": 900,
          "expect": {
            "panel": "open",
            "focus": "sheet:scale:5",
            "writes": [],
            "label": "Noter 5 sur 10"
          },
          "why": "le relâchement de l'appui maintenu ne valide rien (garde anti-clic fantôme)"
        },
        {
          "do": "right",
          "expect": {
            "focus": "sheet:scale:6"
          }
        },
        {
          "do": "left",
          "expect": {
            "focus": "sheet:scale:5"
          }
        },
        {
          "do": "left",
          "expect": {
            "focus": "sheet:scale:4"
          }
        },
        {
          "do": "up",
          "expect": {
            "focus": "sheet:close",
            "label": "Retour"
          }
        },
        {
          "do": "down",
          "expect": {
            "focus": "sheet:scale:5"
          },
          "why": "le cran RETENU (aucune note : 5), jamais le cran quitté"
        },
        {
          "do": "down",
          "expect": {
            "focus": "sheet:action:play"
          },
          "why": "première visite des pictos : la lecture"
        },
        {
          "do": "right",
          "expect": {
            "focus": "sheet:action:watchlist"
          }
        },
        {
          "do": "up",
          "expect": {
            "focus": "sheet:scale:5"
          }
        },
        {
          "do": "down",
          "expect": {
            "focus": "sheet:action:watchlist"
          },
          "why": "le dernier picto visité"
        },
        {
          "do": "menu",
          "settleMs": 900,
          "expect": {
            "panel": "closed",
            "focus": "library:db4c1708cbb5dd1676284a40f2950aba:0",
            "writes": []
          }
        }
      ]
