  "scenarios": [
    {
      "id": "preconfig-parcours-famille",
      "title": "Bout à bout : jumelage → « Qui regarde ? » → le propriétaire règle sa barre et l'applique à Tom → rail conforme ; Léa (deux bibliothèques) a SA page ; Tom arrive directement à l'accueil, barre copiée",
      "start": {
        "session": "none",
        "fixtures": [
          "preconfig/famille-trois-profils",
          "preconfig/invitee-deux-bibliotheques",
          "preconfig/jumelage-ok"
        ],
        "storage": {
          "tentacle_tv_rail_profiles": "{}"
        },
        "keys": [
          "wait:5"
        ]
      },
      "steps": [
        {
          "do": "wait:1",
          "expect": {
            "focus": "pairing:showCode",
            "route": "PairCode"
          }
        },
        {
          "do": "right",
          "expect": {
