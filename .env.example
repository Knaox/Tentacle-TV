# ══════════════════════════════════════════════════
# TENTACLE — Environment Variables
# ══════════════════════════════════════════════════
# Copy to .env and fill in ALL required values before starting.

# ─── Database (MariaDB) — REQUIRED ───
MYSQL_ROOT_PASSWORD=CHANGE_ME_generate_with_openssl_rand_-base64_32
MYSQL_PASSWORD=CHANGE_ME_generate_with_openssl_rand_-base64_32
# DB_USER=tentacle_user
# DB_NAME=tentacle_db

# ─── Authentication — REQUIRED ───
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_-base64_64

# ─── Server ───
PORT=3000
HOST=0.0.0.0

# ─── CORS (comma-separated origins, leave empty for permissive dev mode) ───
# CORS_ORIGINS=https://tentacle.example.com,tauri://localhost

# ─── Tentacle public URL (for Jellyfin CORS auto-injection) ───
# TENTACLE_PUBLIC_URL=https://tentacle.example.com

# ─── Web interface (on by default) ───
# "off": the web client answers 404; the API, the apps, the LG TV client (/tv)
# and the setup wizard (until setup is done) keep working. Back on: "on" and a
# restart, or `tentacle web on` (no restart).
# TENTACLE_WEB_UI=off

# ─── Watch Together chat GIFs (Klipy API key — LOCAL DEV ONLY) ───
# In production the key is COMPILED into the build by CI (GitHub secret
# KLIPY_API_KEY baked before tsc) and this variable is ignored. Set it here
# only for local development.
# KLIPY_API_KEY=

# ─── Local Development (not needed for Docker) ───
# VITE_BACKEND_URL=http://localhost:3001

# Analyse audio inter-épisodes (openings/endings) : chemin de fpcalc si le
# binaire n'est pas sur le PATH. L'image Docker l'embarque ; en dev, un ffmpeg
# compilé avec chromaprint sert de repli. Sans les deux : désactivée, dit une fois.
# FPCALC_PATH=/usr/bin/fpcalc
