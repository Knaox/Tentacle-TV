+package com.swmansion.rnscreens
+
+import android.animation.Animator
+import android.animation.AnimatorListenerAdapter
+import android.animation.ObjectAnimator
+import android.view.View
+import android.view.ViewGroup
+import android.view.animation.AccelerateDecelerateInterpolator
+import android.view.animation.AnimationUtils
+import java.util.WeakHashMap
+
+/**
+ * Tentacle patch (Android TV) : un écran RECOUVERT par un autre, opaque, reste
+ * attaché à la fenêtre au lieu d'être retiré (`transaction.remove`).
+ *
+ * Retiré, il perdait tout : chaque vue détachée (l'accueil : ~1 800), ses
+ * images Fresco relâchées, ses listes d'affichage jetées par HWUI. Au retour,
+ * React Native rattachait tout et réenregistrait tout dans UNE image — 150 à
+ * 170 ms de fil d'interface figé sur une NVIDIA Shield, à chaque Retour.
+ *
+ * Gardé : attaché mais plus DESSINÉ une fois son fondu fini
+ * (`ScreenStack.drawChild` : `isHidden`) — rien ne le parcourt ni ne s'abîme
+ * à cause de lui tant qu'il est caché, ses vues, ses images et sa mise en
+ * page restent ; au retour, seul son affichage se réenregistre. Focus bloqué
+ * (`FOCUS_BLOCK_DESCENDANTS` : aucune flèche n'y entre), retiré de
+ * l'accessibilité. Les fondus de la pile sont rejoués à l'identique : ceux de
+ * `rns_fade_out` / `rns_fade_in` (même durée, même courbe — celle d'une
+ * `Animation` sans interpolateur), et l'écran qui s'efface est dessiné
+ * PAR-DESSUS le nouveau, comme la vue qui partait (`ScreenStack.dispatchDraw`).
+ * Caché, il quitte la pile sans animation (`ScreenStack.removeHiddenCovered`) :
+ * il ne reparaît pas le temps de son retrait.
+ *
+ * Opt-in (`ScreenStack.keepCoveredScreensAttached`) : sans lui, rien ne change.
+ */
+internal class CoveredScreens(
+    private val stack: ViewGroup,
+) {
+    /** Les écrans recouverts, et ce qu'on leur a pris. */
+    private class Saved(
+        val descendantFocusability: Int,
+        val importantForAccessibility: Int,
+    )
+
+    private val covered = WeakHashMap<View, Saved>()
+    private val running = WeakHashMap<View, Animator>()
+
+    /** L'écran qui s'efface par-dessus le nouveau, le temps de son fondu. */
+    var fadingOut: View? = null
+        private set
+
+    private val fadeDuration: Long by lazy {
+        AnimationUtils.loadAnimation(stack.context, R.anim.rns_fade_out).duration
+    }
+
+    fun isCovered(view: View): Boolean = covered.containsKey(view)
+
+    /** Recouvert et son fondu fini : il ne se dessine plus. */
+    fun isHidden(view: View): Boolean = covered.containsKey(view) && running[view] == null
+
+    /** Recouvert : invisible, sans focus ni accessibilité ; `fade` : il s'efface. */
+    fun cover(
+        view: View,
+        fade: Boolean,
+    ) {
+        if (covered.containsKey(view)) return
+        covered[view] = Saved(
+            (view as? ViewGroup)?.descendantFocusability ?: ViewGroup.FOCUS_BEFORE_DESCENDANTS,
+            view.importantForAccessibility,
+        )
+        (view as? ViewGroup)?.descendantFocusability = ViewGroup.FOCUS_BLOCK_DESCENDANTS
+        view.importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_NO_HIDE_DESCENDANTS
+        // Comme un écran retiré : son élément focalisé rend le focus, qu'Android
+        // donne au premier focalisable de la fenêtre — le nouvel écran.
+        if (view.hasFocus()) view.findFocus()?.clearFocus()
+        animateAlpha(view, 0f, fade)
+    }
+
+    /** Découvert : focus et accessibilité rendus ; `fade` : il réapparaît. */
+    fun uncover(
+        view: View,
+        fade: Boolean,
+    ) {
+        val saved = covered.remove(view) ?: return
+        (view as? ViewGroup)?.descendantFocusability = saved.descendantFocusability
+        view.importantForAccessibility = saved.importantForAccessibility
+        animateAlpha(view, 1f, fade)
+    }
+
+    /** Oublié (l'écran quitte la pile, retiré à l'ancienne) : plus rien ne court,
+     *  et la vue retrouve tout ce qu'on lui avait pris — un fragment rattaché
+     *  plus tard la reprendrait telle quelle. */
+    fun forget(view: View) {
+        running.remove(view)?.cancel()
+        if (fadingOut === view) fadingOut = null
+        val saved = covered.remove(view) ?: return
+        (view as? ViewGroup)?.descendantFocusability = saved.descendantFocusability
+        view.importantForAccessibility = saved.importantForAccessibility
+        view.alpha = 1f
+    }
+
+    private fun animateAlpha(
+        view: View,
+        to: Float,
+        fade: Boolean,
+    ) {
+        running.remove(view)?.cancel()
+        if (fadingOut === view) fadingOut = null
+        if (!fade || view.alpha == to) {
+            view.alpha = to
+            stack.invalidate()
+            return
+        }
+        if (to == 0f) fadingOut = view
+        val animator =
+            ObjectAnimator.ofFloat(view, View.ALPHA, view.alpha, to).apply {
+                duration = fadeDuration
+                interpolator = AccelerateDecelerateInterpolator()
+                addListener(
+                    object : AnimatorListenerAdapter() {
+                        override fun onAnimationEnd(animation: Animator) {
+                            if (running[view] === animation) running.remove(view)
+                            if (fadingOut === view) fadingOut = null
+                            stack.invalidate()
+                        }
+                    },
+                )
+            }
+        running[view] = animator
+        animator.start()
+    }
+}
