--- /dev/null
+++ b/android/src/main/java/com/swmansion/rnscreens/IosFade.kt
@@ -0,0 +1,110 @@
+package com.swmansion.rnscreens
+
+import android.animation.Animator
+import android.animation.TimeAnimator
+import android.view.View
+import android.view.animation.AlphaAnimation
+import android.view.animation.Animation
+import android.view.animation.AnimationSet
+import android.view.animation.PathInterpolator
+import android.view.animation.Transformation
+
+/**
+ * Tentacle patch (Android TV) : le fondu de la pile À LA MANIÈRE D'iOS
+ * (`RNSScreenStackAnimator`, `animateFadeWithTransitionContext`), opt-in par
+ * `ScreenStack.fadeLikeIos`.
+ *
+ * iOS : au push, le nouvel écran passe de 0 à 1 PAR-DESSUS l'ancien, resté à 1 ;
+ * au retour, l'écran qui part passe de 1 à 0 par-dessus celui qui revient, déjà
+ * à 1 — en `transitionDuration` (`animationDuration`), sur la courbe
+ * `UIViewAnimationCurveEaseInOut`. Android effaçait l'un pendant que l'autre
+ * paraissait, en 150 ms : le fond passait entre les deux, un creux sombre au
+ * milieu du fondu.
+ *
+ * Deux écrans opaques : « le nouveau paraît par-dessus l'ancien » et « l'ancien
+ * s'efface par-dessus le nouveau » font la MÊME image, a·N + (1 − a)·A. Ici,
+ * c'est donc toujours l'écran QUI S'EN VA qui s'efface, par-dessus : un écran
+ * qui ne change plus — son calque ne se redessine pas, quand celui qui se monte
+ * se redessinerait à chaque bloc de vues reçu. Celui qui reste ou qui arrive
+ * est à 1 d'emblée. Les animations de la transaction ne sont plus que des
+ * maintiens (`rns_no_animation_350`), mis à la durée d'iOS : les évènements de
+ * transition tombent quand le fondu finit, et l'écran retiré reste là jusque-là.
+ *
+ * Le temps de la course avance avec les IMAGES rendues, d'au plus deux images
+ * à la fois (`MAX_STEP_MS`) : retenu par le montage du nouvel écran, le fil
+ * d'interface ne fait plus sauter le fondu — il reprend où il en était.
+ */
+internal object IosFade {
+    /** Ce qu'une image en retard avance au plus : deux images à 60 Hz. */
+    const val MAX_STEP_MS = 34L
+
+    /** Sans `animationDuration` : la durée de react-native-screens sur iOS. */
+    private const val DEFAULT_DURATION_MS = 500L
+
+    /** `UIViewAnimationCurveEaseInOut`. */
+    fun curve() = PathInterpolator(0.42f, 0f, 0.58f, 1f)
+
+    fun durationOf(screen: Screen?): Long = screen?.transitionDuration?.takeIf { it >= 0 }?.toLong() ?: DEFAULT_DURATION_MS
+
+    /**
+     * L'animation d'un écran que la transaction ajoute ou retire : son maintien
+     * mis à la durée du fondu ; retiré, il s'efface de `exitFrom` à 0.
+     */
+    fun transition(
+        animation: Animation,
+        removing: Boolean,
+        durationMs: Long,
+        exitFrom: Float,
+        progress: Animation,
+        listener: Animation.AnimationListener,
+    ): Animation {
+        animation.duration = durationMs
+        progress.duration = durationMs
+        return SteadyAnimationSet().apply {
+            addAnimation(animation)
+            addAnimation(progress)
+            if (removing) {
+                addAnimation(
+                    AlphaAnimation(exitFrom, 0f).apply {
+                        duration = durationMs
+                        interpolator = curve()
+                    },
+                )
+            }
+            setAnimationListener(listener)
+        }
+    }
+
+    /** L'effacement d'un écran recouvert, par-dessus le nouveau (`CoveredScreens`). */
+    fun fadeOut(
+        view: View,
+        durationMs: Long,
+    ): Animator {
+        val from = view.alpha
+        val curve = curve()
+        var elapsedMs = 0L
+        return TimeAnimator().apply {
+            setTimeListener { animator, _, deltaMs ->
+                elapsedMs += deltaMs.coerceIn(0L, MAX_STEP_MS)
+                val fraction = (elapsedMs.toFloat() / durationMs).coerceAtMost(1f)
+                view.alpha = from * (1f - curve.getInterpolation(fraction))
+                if (fraction >= 1f) animator.end()
+            }
+        }
+    }
+
+    /** Un ensemble d'animations dont le temps avance d'au plus `MAX_STEP_MS` par image. */
+    private class SteadyAnimationSet : AnimationSet(false) {
+        private var lastRealMs = -1L
+        private var steadyMs = 0L
+
+        override fun getTransformation(
+            currentTime: Long,
+            outTransformation: Transformation,
+        ): Boolean {
+            steadyMs = if (lastRealMs < 0) currentTime else steadyMs + (currentTime - lastRealMs).coerceIn(0L, MAX_STEP_MS)
+            lastRealMs = currentTime
+            return super.getTransformation(steadyMs, outTransformation)
+        }
+    }
+}
