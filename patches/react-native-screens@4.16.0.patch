+#if TARGET_OS_TV
+#pragma mark - tvOS Menu button (Tentacle patch)
+
+// Tentacle patch : depuis tvOS 26, UIKit dépile par un GESTE — un
+// `UITapGestureRecognizer` Menu posé sur la vue du contrôleur de navigation,
+// dont celui-ci est le délégué (`_backGestureRecognizer`). Un geste voit
+// l'appui AVANT la chaîne de répondeurs : l'écran était dépilé avant que le
+// patch de `RNSScreen` (`pressesEnded`) ou une vue de l'application ne puisse
+// le retenir, puis réempilé par `viewDidDisappear` — et l'écran du dessous
+// restait visible quelques images (mesuré au simulateur tvOS 26.2 : 40 à
+// 70 ms, à chaque Retour qui ne devait fermer qu'un panneau).
+//
+// Le geste ne commence donc plus quand l'écran du dessus le refuse :
+// - `preventNativeDismiss` (`usePreventRemove`) : l'appui suit la chaîne de
+//   répondeurs jusqu'au patch de `RNSScreen`, qui le rend au JS ;
+// - `gestureEnabled: false` : Menu ne dépile jamais cet écran — l'appui va à
+//   l'application, et sinon à UIKit, qui QUITTE l'application (la règle
+//   d'Apple), même avec des écrans empilés dessous.
+- (BOOL)gestureRecognizerShouldBegin:(UIGestureRecognizer *)gestureRecognizer
+{
+  if ([gestureRecognizer.allowedPressTypes containsObject:@(UIPressTypeMenu)] &&
+      [self.topViewController isKindOfClass:[RNSScreen class]]) {
+    RNSScreenView *screenView = ((RNSScreen *)self.topViewController).screenView;
+    if (!screenView.gestureEnabled || screenView.preventNativeDismiss) {
+      return NO;
+    }
+  }
+  if ([UINavigationController instancesRespondToSelector:@selector(gestureRecognizerShouldBegin:)]) {
+    return [super gestureRecognizerShouldBegin:gestureRecognizer];
+  }
+  return YES;
+}
+#endif // TARGET_OS_TV
