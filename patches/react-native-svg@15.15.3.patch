+  // Tentacle patch : UN contexte RenderScript et UN script de flou pour toute
+  // l'application, créés au premier flou puis réutilisés. En créer puis en
+  // détruire un à CHAQUE passe coûtait des dizaines de millisecondes sur le fil
+  // UI, à chaque dessin du filtre — le halo d'une bannière qui tourne toutes
+  // les huit secondes, celui d'une bibliothèque à son ouverture.
+  private static RenderScript sRenderScript;
+  private static ScriptIntrinsicBlur sBlurScript;
+
+  private static synchronized ScriptIntrinsicBlur sharedBlur(Context context) {
+    if (sBlurScript == null) {
+      sRenderScript = RenderScript.create(context.getApplicationContext());
+      sBlurScript = ScriptIntrinsicBlur.create(sRenderScript, Element.U8_4(sRenderScript));
+    }
+    return sBlurScript;
+  }
