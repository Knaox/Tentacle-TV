apps/backend/prisma/*.db

# Backend runtime data (contains DB credentials)
apps/backend/data/

# Mobile — iOS native (projet versionné pour le build CI sans EAS ; on commit
# la source du projet Xcode — AirPlayModule.m câblé dans le pbxproj — et on
# ignore uniquement les artefacts régénérés par `pod install` / xcodebuild).
# Bundles JS produits par Metro. La CI les régénère (`gradlew bundleRelease`) ;
# un bundle laissé dans `src/main/assets/` y est fusionné par Gradle et peut
# masquer celui du build. Celui d'Android TV y a gardé l'ancien logo pendant
# trois mois, personne ne l'ayant vu. Le motif couvre les deux applications :
# `apps/mobile/android/.gitignore` n'ignore que `*.jsbundle`, qui ne correspond
# pas au nom Android.
apps/*/android/app/src/main/assets/index.android.bundle

apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/ios/DerivedData/
apps/mobile/ios/.xcode.env.local
apps/mobile/ios/**/xcuserdata/
apps/mobile/ios/*.xcworkspace/contents.xcworkspacedata.bak

# Apple TV — FFmpeg LGPL xcframeworks : COMMITÉS (~46 Mo) pour que le CI release-atv
# dispose des binaires (le code remux `#include`e libavformat). Régénérables via
# apps/tv/ios/scripts/build-ffmpeg-lgpl-tvos.sh (script + podspec versionnés → LGPL OK).
# Apple TV — artefacts de build xcodebuild (simulateur + device) : régénérés.
apps/tv/ios/build/
apps/tv/ios/build-device/
apps/tv/ios/build-sim/
apps/tv/ios/DerivedData/

# Outil de déploiement perso (repo public) — reste en local / sur le Bureau
tools/deploy/

# Cloudflare Workers (deployed separately via wrangler)
download/

