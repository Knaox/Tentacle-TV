{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // Pas les options strictes supplémentaires (`noUncheckedIndexedAccess`,
    // `exactOptionalPropertyTypes`…) : tsc les appliquerait aussi aux sources
    // de `packages/shared` importées, qui ne sont pas écrites pour elles.
    "types": ["node"]
  },
  "include": ["src"]
}
